					<register>
						<name>MCSi_ERR</name>
						<description>MCS0 error register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>124</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>ERR0</name>
								<description>Error State of MCS channel 7. The CPU can read the ERRx  x   0..T 1  bits in order to determine the          current error state of the corresponding MCS channel x. The error state is also evaluated by the sub module MON  if this          module is available. Writing the value 1 to this bit resets the corresponding error state           and resets the channel internal ERR bit in the STA and channel CTRL          registers. Moreover  each write access to this bit also sets the          ERR SRC ID bit field of register MCS i  CTRL STAT to its reset value.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>ERR1</name>
								<description>Error State of MCS channel 7. The CPU can read the ERRx  x   0..T 1  bits in order to determine the          current error state of the corresponding MCS channel x. The error state is also evaluated by the sub module MON  if this          module is available. Writing the value 1 to this bit resets the corresponding error state           and resets the channel internal ERR bit in the STA and channel CTRL          registers. Moreover  each write access to this bit also sets the          ERR SRC ID bit field of register MCS i  CTRL STAT to its reset value.</description>
								<lsb>1</lsb>
								<msb>1</msb>
								<access>read-write</access>
							</field>

 resetvalue={Application Reset:0x0}</description>
						<addressOffset>72</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>SPE_PAT_PTR_BWD</name>
								<description>Pattern selector for TOM output signals in case of SPE CTRL CMD   0b01  e.g. backward direction . Index into the SPE i  OUT PAT z  register table in case of SPE CTRL CMD          0b01 which may be used for backward direction. Each register SPE i  OUT PAT x  is fixed assigned to one bit field        IPx PAT of register SPE i  PAT. Thus  the pointer SPE i  PAT PTR BWD        represents an index to the selected SPE i  OUT PAT x  register as well        as the actual detected input pattern IPx PAT. The index pointer SPE PAT PTR BWD is used if SPE CTRL CMD  160   0b01. The index pointer SPE PAT PTR is used if SPE CTRL CMD  160    160 0b00  by        default .</description>
								<lsb>8</lsb>
								<msb>10</msb>
								<access>read-write</access>
							</field>
						</fields>

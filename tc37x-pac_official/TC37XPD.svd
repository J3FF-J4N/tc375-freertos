							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RXF_OFL</name>
							<description>RX FIFO Overflow   RXF OFL</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TXF_UFL</name>
							<description>TX FIFO Underflow   TXF UFL</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TXF_OFL</name>
							<description>TX FIFO Overflow   TXF OFL</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ERRIRQSS</name>
					<description>Error Interrupt Request Source Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>100</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RXF_UFL</name>
							<description>RX FIFO Underflow   RXF UFL. The FIFO has detected an RX FIFO underflow.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>RXF_OFL</name>
							<description>RX FIFO Overflow   RXF OFL. The I2C kernel has detected a RX FIFO overflow</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TXF_UFL</name>
							<description>TX FIFO Underflow   TXF UFL. The I2C kernel has detected a TX FIFO underflow.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TXF_OFL</name>
							<description>TX FIFO Overflow   TXF OFL. The FIFO has detected a TX FIFO overflow.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ERRIRQSC</name>
					<description>Error Interrupt Request Source Clear Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>104</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RXF_UFL</name>
							<description>RX FIFO Underflow   RXF UFL</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>RXF_OFL</name>
							<description>RX FIFO Overflow   RXF OFL</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>TXF_UFL</name>
							<description>TX FIFO Underflow   TXF UFL</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>TXF_OFL</name>

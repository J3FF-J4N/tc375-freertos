				<register>
					<name>MFLAGS</name>
					<description>Miscellaneous Flags Register
 resetvalue={Application Reset:0x080000000}</description>
					<addressOffset>24</addressOffset>
					<size>32</size>
					<resetValue>2147483648</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>NACK</name>
							<description>Not Acknowledge Error   Target Error   NACK. Indicates for each channel that a target error frame has been received.</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TTE</name>
							<description>Transaction Tag Error   TTE. Indicates for each channel if a CRC correct acknowledge frame with an        unexpected transaction tag number has been received.</description>
							<lsb>4</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TIMEOUT</name>
							<description>Timeout Error   TIMEOUT. Indicates for each channel if an timeout event has occurred.</description>
							<lsb>8</lsb>
							<msb>11</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>UNEXPECTED</name>
							<description>Unexpected Type of Frame Error   UNEXPECTED. Indicates for each channel if an unexpected or inappropriate response is        received. For example a NACK for a Trigger frame or DATA for WRITE frame.</description>
							<lsb>12</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TMB</name>
							<description>Target Memory Block   TMB. Selects the currently active memory block used by the target as a target        for the streaming data  with its start address and frame counter.        Switching the active block in the middle of a block transfer is not        allowed.</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>IMB</name>
							<description>Initiator Memory Block   IMB. Selects the currently active memory block used by the initiator as a        source for the streaming data  with its start address and frame counter.        Switching the active block in the middle of a block transfer is not        allowed.</description>
							<lsb>19</lsb>
							<msb>19</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ISB</name>
							<description>Initiator Stream Block Request   ISB. Indicates if stream block request is pending. Set by the software to        start a stream block transfer by using the MFLAGSSET.ISBS bit  clear by        the software possible  if needed  by using the MFLAGSCL.ISBC bit         cleared by hardware at the end of the current block transfer in single        mode  but not in continuous mode.</description>
							<lsb>20</lsb>
							<msb>20</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MAV</name>
							<description>Memory Access Violation   MAV. Indicates a memory access violation.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SRIE</name>
							<description>SRI SPB Bus Access Error   SRIE. Indicates an error on the SRI bus   transaction ID  ECC error or error        acknowledge. Indicates an error on the SPB bus  error acknowledge or timeout.</description>
							<lsb>22</lsb>
							<msb>22</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>PIE1</name>
							<description>PHY Inconsistency Error 1 Channel Number Code Error    PIE1. Indicates if HSCT to HSSL channel number code comparator has detected an        inconsistency error.</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>PIE2</name>
							<description>PHY Inconsistency Error 2 Data Length Error    PIE2. Indicates if HSCT to HSSL data length comparator has detected an        inconsistency error.</description>
							<lsb>24</lsb>
							<msb>24</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CRCE</name>
							<description>CRC Error   CRCE. Indicates if CRC checker has detected a CRC error.</description>
							<lsb>25</lsb>
							<msb>25</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TSE</name>
							<description>Target Stream Enable   TSE. Used by the hardware to handle the single and continuous streaming. In        single mode  cleared by hardware after the current block transfer ends.        The module ignores afterwards the incoming steam frames.</description>
							<lsb>28</lsb>
							<msb>28</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TEI</name>
							<description>Transmit Enable Input   TEI. Indicates the state of the TEI input signal of the HSSL module  which is        driven by the CTS output signal of the HSCT module. Any edge on this        signal triggers an EXI interrupt. This low level signal stops the transmission of both command and        response frames.</description>
							<lsb>29</lsb>
							<msb>29</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TEO</name>
							<description>Transmit Enable Output   TEO. Indicates the state of the TEO output signal of the HSSL module  which        drives thee CTS input signal of the HSCT module. This bit is cleared by        hardware at entering the INIT and Soft Suspend state.</description>
							<lsb>30</lsb>
							<msb>30</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>INI</name>
							<description>Initialize Mode   INI. Indicates if the module is in the Initialize or Run mode.</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>

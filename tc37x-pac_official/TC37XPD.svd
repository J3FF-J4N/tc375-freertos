							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SD5</name>
							<description>SD7   SD7. Send data of next ECU to Sensor frame.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SD6</name>
							<description>SD7   SD7. Send data of next ECU to Sensor frame.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SD7</name>
							<description>SD7   SD7. Send data of next ECU to Sensor frame.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TSI</name>
							<description>Trigger Pulse Indicator   TSI. If this bit is set  a sync pulse is assumed and thus a time stamp is captured when the command leaves the FIFO and is written to ASC TX Register. Bits SD 7 5  select the channel for which the time stamp is captured. RCRAx.TSTS must be cleared. If set  the time stamp is captured on Packet Frame reception only.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CON</name>
					<description>Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>528</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>M</name>
							<description>Mode Selection   M</description>
							<lsb>0</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STP</name>
							<description>Number of Stop Bit Selection   STP</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>REN</name>
							<description>Receiver Enable Control   REN. Bit is reset by hardware after reception of a Byte in Synchronous Mode.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>PEN</name>
							<description>Parity Check Enable  asynchronous mode only    PEN</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>FEN</name>
							<description>Framing Check Enable  asynchronous mode only    FEN</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>OEN</name>
							<description>Overrun Check Enable   OEN</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>PE</name>
							<description>ASC Parity Error Flag   PE. Set by hardware on a parity error  PEN   1 . Must be reset by software.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>FE</name>
							<description>ASC Framing Error Flag   FE. Set by hardware on a framing error  FEN   1 . Must be reset by software.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>OE</name>
							<description>ASC Overrun Error Flag   OE. Set by hardware on an overrun error  OEN   1 . Must be reset by software.</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>FDE</name>
							<description>Fractional Divider Enable   FDE. FDE is don t care and assumed  0  in Synchr. Mode.</description>
							<lsb>11</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ODD</name>
							<description>Parity Selection   ODD</description>
							<lsb>12</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>BRS</name>
							<description>Baud Rate Selection   BRS. BRS is don t care if FDE   1  fractional divider enabled  FDE is don t care and assumed  0  in Synchr. Mode.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>LB</name>
							<description>Loop back Mode Enable   LB</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>R</name>
							<description>Baud Rate Generator Run Control   R. Register BG should only be written if R   0.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MTX</name>
							<description>Mode Selection TX direction   MTX. While bit field M controls the RX path  MTX controls the mode for the TX path.</description>
							<lsb>16</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ODDTX</name>
							<description>Parity Selection TX direction   ODDTX. While bit field ODD controls the RX path  ODDTX controls the mode for the TX path.</description>
							<lsb>28</lsb>
							<msb>28</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>BG</name>

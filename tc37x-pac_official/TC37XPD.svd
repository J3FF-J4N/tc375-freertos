						<name>CH3_IRQ_EN</name>
						<description>TOM0 Channel 15 Interrupt Enable Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>224</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CCU0TC_IRQ_EN</name>
								<description>TOM CCU0TC IRQ interrupt enable</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CCU1TC_IRQ_EN</name>
								<description>TOM CCU1TC IRQ interrupt enable. Coding see bit 0.</description>
								<lsb>1</lsb>
								<msb>1</msb>

							<name>MSIZE0</name>
							<description>Compare Register Size for CMP0   MSIZE0. This bit field determines the number of bits in register CMP0  starting from bit 0  that are used for the compare operation with the System Timer. ...</description>
							<lsb>0</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MSTART0</name>
							<description>Start Bit Location for CMP0   MSTART0. This bit field determines the lowest bit number of the 64 bit STM that is compared with the content of register CMP0 bit 0. The number of bits to be compared is defined by bit field MSIZE0. ...</description>
							<lsb>8</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MSIZE1</name>
							<description>Compare Register Size for CMP1   MSIZE1. This bit field determines the number of bits in register CMP1  starting from bit 0  that are used for the compare operation with the System Timer. ...</description>
							<lsb>16</lsb>
							<msb>20</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MSTART1</name>
							<description>Start Bit Location for CMP1   MSTART1. This bit field determines the lowest bit number of the 64 bit STM that is compared with the content of register CMP1 bit 0. The number of bits to be compared is defined by bit field MSIZE1. ...</description>
							<lsb>24</lsb>
							<msb>28</msb>
							<access>read-write</access>
						</field>
					</fields>

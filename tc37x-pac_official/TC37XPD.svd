							<name>DATA</name>
							<description>Data   DATA. Reading from this bit field takes content from the RXFIFO  depending on        the read width   8  16 or 32 bit  see RXFIFOCON.OUTW   but does not        influence the read pointer of the RXFIFO. A write access to this        register has no effect.</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>

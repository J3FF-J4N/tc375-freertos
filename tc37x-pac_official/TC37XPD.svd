		<peripheral>
			<name>PSI5</name>
			<version>100</version>
			<description>PSI5</description>
			<baseAddress>4026552320</baseAddress>
			<addressBlock>
				<offset>0</offset>
				<size>2816</size>
				<usage>registers</usage>
			</addressBlock>
			<registers>
				<cluster>
					<dim>2</dim>
					<dimIncrement>144</dimIncrement>
					<name>CH[%s]</name>
					<description>CH</description>
					<addressOffset>48</addressOffset>
					<register>
						<name>IOCRx</name>
						<description>Input and Output Control Register 0
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>0</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>ALTI</name>
								<description>Alternate Input Select   ALTI. Selects the alternate input for channel x </description>
								<lsb>0</lsb>
								<msb>1</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>DEPTH</name>
								<description>Digital Glitch Filter Depth   DEPTH. DEPTH determines the number of port input samples clocked with f PSI5        that are taken into account for the calculation of the floating average.        The higher DEPTH is chosen to be  the longer the glitches that are        suppressed and the longer the delay of the input signal introduced by        this filter.</description>
								<lsb>4</lsb>
								<msb>7</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>OIE</name>
								<description>Output Inverter Enable Channel x   OIE. Selects the Pulse Polarity of the output of channel x</description>
								<lsb>8</lsb>
								<msb>8</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>IIE</name>
								<description>Input Inverter Enable Channel x   IIE. Selects the Pulse Polarity of the input of channel x</description>
								<lsb>9</lsb>
								<msb>9</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>REG</name>
								<description>Rising Edge Glitch Flag for Channel x   REG. Shows the status of the glitch detection of channel x REG is cleared by setting CREG.</description>
								<lsb>12</lsb>
								<msb>12</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>FEG</name>
								<description>Falling Edge Glitch Flag for Channel x   FEG. Shows the status of the glitch detection of channel x FEG is cleared by setting CFEG.</description>
								<lsb>13</lsb>
								<msb>13</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CREG</name>
								<description>Clear Rising Edge Glitch Flag for Channel x   CREG. Clears the status flag REG CREG always read zero.</description>
								<lsb>14</lsb>
								<msb>14</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>CFEG</name>
								<description>Clear Falling Edge Glitch Flag for Channel x   CFEG. Clears the status flag FEG CFEG always read zero.</description>
								<lsb>15</lsb>
								<msb>15</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>RXM</name>
								<description>Receive Monitor for Channel x   RXM. Shows the status of the receive signal of channel x after glitch        filtering and inverted as specified by IIE.</description>
								<lsb>30</lsb>
								<msb>30</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>TXM</name>
								<description>Transmit Monitor for Channel x   TXM. Shows the status of the transmit signal of channel x inverted as        specified by OIE.</description>
								<lsb>31</lsb>
								<msb>31</msb>
								<access>read-only</access>
							</field>
						</fields>

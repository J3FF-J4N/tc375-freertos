					<fields>
						<field>
							<name>P5FLOAT</name>
							<description>AMU P5 Parameter Register  Float    P5FLOAT. This bit field holds the parameter p5 of the algorithm.</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>UPFLOAT</name>
					<description>Input Vector u Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>60</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>UPFLOAT</name>
							<description>AMU Input Vector Register  Pointer to Float    UPFLOAT. This bit field holds a pointer to the input vector array u  M  of the algorithm.</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>OLCOMP</name>
					<description>Parameter p8 Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>64</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>CP8H2N</name>
							<description>Trigger Value for switch from half to full speed   CP8H2N. This register should be programmed with the p8 value when the AMU should switch from running at half programmed speed to full programmed speed. For instructions to use  please refer to the section about current shaping.</description>
							<lsb>0</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CPHN2H</name>
							<description>Trigger Value for switch from full to half speed   CPHN2H. This register should be programmed with the p8 value when the AMU should switch from running at full programmed speed to half programmed speed. For instructions to use  please refer to the section about current shaping.</description>
							<lsb>16</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CTRL0</name>
					<description>Control Register 0
 resetvalue={Application Reset:0x7000}</description>
					<addressOffset>68</addressOffset>
					<size>32</size>
					<resetValue>28672</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>EN</name>
							<description>Enable Bit   EN. Write 1 to enable the algorithm. Write 0 to disable the algorithm. The flag will return a 1 if read while        the algorithm is running and 0 is the        algorithm is stopped or finished.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ENCN</name>
							<description>Enable Condition Bit   ENCN. This bit must be written with 1 to        change the EN field. If 0 is written the        value written to the EN field is ignored. Always read as 0 .</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>READY</name>
							<description>Ready Flag   READY. This bit is cleared by hardware when a computation starts and set by hardware upon successful completion of the computation.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SDOWN</name>
							<description>Slowdown Flag   SDOWN. The flags can be used to slow down the state machine which controls the algorithm.</description>
							<lsb>3</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SDOWNCN</name>
							<description>Slowdown Condition Bit   SDOWNCN. This bit must be written with 1 to change the SDOWN field. If 0 is written the value written to the SDOWN field is ignored. Always read as 0 .</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>LI</name>
							<description>Limit Interrupt   LI. This flag shows the state of the limit interrupt. This interrupt is raised when the AMU outer loop counter reaches the value provided in p10. Cleared by hardware when read or on the start of the next execution   0 to 1 transition on EN .</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ERR</name>
							<description>Error Interrupt   ERR. This flag signifies that an error during the computation has occurred. An interrupt is raised. Cleared by hardware when read or on the start of the next execution   0 to 1 transition on EN .</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>LIM2RDY</name>
							<description>Limit to Ready Interrupt   LIM2RDY. If this flag is set  a limit interrupt is also signaled at the ready interrupt line.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RDY2LIM</name>
							<description>Ready to Limit Interrupt   RDY2LIM. If this flag is set  the ready interrupt is also signaled the limit interrupt line.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SL</name>
							<description>Stop on Limit Interrupt   SL. If this flag is set  AMU stops on limit interrupt</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>REGACCEN</name>
							<description>Allow Register Write when Active   REGACCEN. If this flag is set  writes to the P10SINT  P6SINT and OLCOMP registers when the AMU is active do not cause an error.</description>
							<lsb>11</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MAX</name>
							<description>Maximum Speed Control   MAX. The field is used to define the speed at which arithmetic operations complete. It can set the speed to between 1 clock cycle  when written with 0   and 8 clock cycles  when written with 7  .</description>
							<lsb>12</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MAXCN</name>
							<description>Maximum Speed Condition Bit   MAXCN. This bit must be written with 1 to change the MAX bits. If 0 is written the value written to the MAX bits is ignored. Always read as 0 .</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>ID</name>
							<description>Identifier   ID. This field is freely readable and writable. Use to identify specific calculation.</description>
							<lsb>16</lsb>
							<msb>22</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>IDCN</name>
							<description>Identifier Condition Bit   IDCN. This bit must be written with 1 to change the ID field. If 0 is written the value written to the ID field is ignored. Always read as 0 .</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>CSH</name>
							<description>Current Shaping Enable   CSH. Write 1 to enable current shaping. See   8220 Current        Shaping  8221  on Page  160 14 for information.</description>
							<lsb>24</lsb>
							<msb>24</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CSHCN</name>
							<description>Current Shaping Enable Condition Bit   CSHCN. This bit must be written with 1 to change the CSH field. If 0 is written the value written to the CSH field is ignored. Always read as 0 .</description>
							<lsb>25</lsb>
							<msb>25</msb>

 resetvalue={Application Reset:0x101}</description>
						<addressOffset>3920</addressOffset>
						<size>32</size>
						<resetValue>257</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>DPLL_DT_S_START</name>
								<description>Start value of DPLL DT S ACT for the first increment after SIP2 is set to 1. For the first increment after setting SIP2 from 0 to 1  the value of        DPLL DT S START is taken instead of the calculated DPLL DT S ACT for the        current increment duration. This value should be always  gt  256 in order        to avoid an overflow during the calculation of DPLL RDT S ACT.</description>
								<lsb>0</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
						</fields>

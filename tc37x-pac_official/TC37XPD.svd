					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>NDBHE</name>
							<description>Number of SRH Bits Shifted at Data Frames Extension   NDBHE. Additional MSB bit extension of the NDBH bit field. Adds 16 to the        resulting NDBH value if set.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>NDBLE</name>
							<description>Number of SRL Bits Shifted at Data Frames Extension   NDBLE. Additional MSB bit extension of the NDBL bit field. Adds 16 to the        resulting NDBL value if set.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>EXEN</name>
							<description>Extension Enable   EXEN. Enables the extension bit fields.</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCF</name>
							<description>Command Command Flag   CCF. This bit flags that a second command frame has been written without data        frame to be sent in between. It is active only if CDCM 1. Otherwise it        is always low.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>INJENP0</name>
							<description>Injection Enable of the Pin 0 Signal   INJENP0. This bit selects if an external signal is injected in a data frame.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INJPOSP0</name>
							<description>Injection Position of the Pin 0 Signal   INJPOSP0. This bit selects the position of the injected external one bit signal         at the bit position in range of 0 to 63 in the data frame. If both PIN0POS and PIN1POS point to a same bit  PIN0POS has the higher        priority  that is PIN0 level will be visible in the data frame.</description>
							<lsb>17</lsb>
							<msb>22</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INJENP1</name>
							<description>Injection Enable of the Pin 1 Signal   INJENP1. This bit selects if an external signal is injected in a data frame.</description>
							<lsb>24</lsb>
							<msb>24</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INJPOSP1</name>
							<description>Injection Position of the Pin 1 Signal   INJPOSP1. This bit selects the position of the injected external one bit signal         at the bit position in range of 0 to 63 in the data frame.</description>
							<lsb>25</lsb>
							<msb>30</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CDCM</name>
							<description>Command Data Command in Data Repetition Mode   CDCM. This bit selects if a data frame is automatically inserted between two        consecutive command frame requests.</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>USCE</name>
					<description>Upstream Control Enhanced Register 1
 resetvalue={Application Reset:0x0FF}</description>
					<addressOffset>92</addressOffset>
					<size>32</size>
					<resetValue>255</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>USTOPRE</name>
							<description>Upstream Time out Prescaler   USTOPRE. Prescaler for the upstream time out limit. Expressed in upstream bit        times. 2 n divider in the range of 1        to 16384. Write to this bit field triggers new start of the watchdog timer.</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>USTOVAL</name>
							<description>Upstream Time out Value   USTOVAL. Upstream time out value for the N divider in the range of 1 to 16         expressed in number of upstream bit time lengths  the upstream bit time        is the reciprocal value of the upstream baud rate . Time out   BitTime          2  USTOPRE 1     USTOVAL 1 . Write to this bit field triggers new start of the watchdog timer.</description>
							<lsb>4</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>USTOEN</name>
							<description>Upstream Time out Interrupt Enable   USTOEN. Enable bit for the upstream time out interrupt. The Time out counter runs continuously independently of the USTOEN bit. The USTOEN enables only the interrupt generation.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>USTF</name>
							<description>Upstream Time out Flag   USTF. Signals an upstream timer event. If set by software  the interrupt is also triggered  if enabled. The watchdog timer runs continuously and sets the USTF flag at overflow  independently from the enable bit. Therefore this bit must be cleared with the same write access which enables the interrupt.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>USTC</name>
							<description>Upstream Time out Clear   USTC. Clears the USTF flag. Write only bit  reads as 0.</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>USTS</name>
							<description>Upstream Time out Set   USTS. Sets the USTF flag. Write only bit  reads as 0.</description>
							<lsb>11</lsb>
							<msb>11</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>UTASR</name>
							<description>Upstream Time out Alternate Service Request   UTASR. Selects if the interrupt signal is routed to the alternate service request node. See CROSSREFERENCE .</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>USTOIP</name>
							<description>Upstream Time out Interrupt Node Pointer   USTOIP. USTOIP selects the service request output line SRn  n   0 3  for the time out interrupt.</description>
							<lsb>14</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>

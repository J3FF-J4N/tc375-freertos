							<lsb>16</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>UIP</name>
							<description>Underflow Interrupt Node Pointer   UIP. UIP selects the service request output line SRn  n  160    160 0 3  for the        underflow interrupt.</description>
							<lsb>19</lsb>
							<msb>20</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>UASR</name>
							<description>Underflow Alternate Service Request   UASR. Selects if the interrupt signal is routed to the alternate service request node. See CROSSREFERENCE .</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-write</access>
						</field>

					<resetValue>34</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RXBS</name>
							<description>RX Burst Size   RXBS. Some DMA controllers do not support a burst size of 2 words.</description>
							<lsb>0</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TXBS</name>
							<description>TX Burst Size   TXBS. Some DMA controllers do not support a burst size of 2 words.</description>
							<lsb>4</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RXFA</name>
							<description>RX FIFO Alignment   RXFA. Use byte alignment wherever it is possible.</description>
							<lsb>8</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TXFA</name>

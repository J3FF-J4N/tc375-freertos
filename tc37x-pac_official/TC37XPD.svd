					</fields>
				</register>
				<register>
					<name>RXEXITD</name>
					<description>RX EXIT Debug Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>148</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>E</name>
							<description>Read Point from the RxFIFO   E</description>
							<lsb>0</lsb>

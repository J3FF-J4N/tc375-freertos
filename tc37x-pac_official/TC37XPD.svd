							<description>Clock On Flag   CON. Shows if the clock in the bit time domain is switched on or off. Many        configuration registers can be written only if this bit shows 0  see        header of registers IOCR  BITCON  FRAMECON  BRG  BRD  LINCON  LINBTIMER         LINHTIMER .</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RXDATAD</name>
					<description>Receive Data Debug Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>80</addressOffset>

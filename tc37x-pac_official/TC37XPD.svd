						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>TSC</name>
								<description>Trigger Sequence Counter   TSC. Controls the effect of an incoming internal trigger  If TSC  gt  00   decrement TSC by one.</description>
								<lsb>0</lsb>
								<msb>5</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>QACT</name>
								<description>Queue Active   QACT. Indicates that request source Q2 is currently executing a sequence. Cleared by writing 1 to bit COV.</description>
								<lsb>14</lsb>
								<msb>14</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>OV</name>

						<field>
							<name>EN</name>
							<description>Enable Bit   EN. Write 1 to enable the algorithm. Write 0 to disable the algorithm. The flag will return a 1 if read while        the algorithm is running and 0 is the        algorithm is stopped or finished.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ENCN</name>

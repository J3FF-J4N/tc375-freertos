							<addressOffset>20</addressOffset>
							<register>
								<name>DTV</name>
								<description>CDTM0 DTM0 Channel 0 Dead Time Reload Values
 resetvalue={Application Reset:0x0}</description>
								<addressOffset>0</addressOffset>
								<size>32</size>
								<resetValue>0</resetValue>
								<resetMask>4294967295</resetMask>
								<fields>
									<field>
										<name>RELRISE</name>
										<description>Reload value for rising edge dead time</description>
										<lsb>0</lsb>

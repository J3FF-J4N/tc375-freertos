							<lsb>12</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>PADCTLI</name>
							<description>Pad input threshold control for Debug Interface Pins. DAP pins always use TTL levels. This bits allows to set correct TTL        levels even for 3.3V supply. Selection valid for DAP and DAPE pads.</description>
							<lsb>14</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>

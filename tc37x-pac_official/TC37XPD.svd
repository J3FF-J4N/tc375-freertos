						<resetValue>0</resetValue>
						<resetMask>0</resetMask>
						<fields>
							<field>
								<name>THVAL</name>
								<description>Measured time from the last active slope to the next inactive TRIGGER slope in time stamp clock counts  this does mean the clock selected for the TBU CH0 BASE  uint16 . The measured value considers all input slope filter delays. From the        received input the corresponding filter delays are subtracted before the        time stamp difference of active and inactive slope is calculated.</description>
								<lsb>0</lsb>
								<msb>23</msb>
								<access>read-write</access>

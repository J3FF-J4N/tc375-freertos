						<field>
							<name>SDEDI</name>
							<description>Set DEDI Flag   SDEDI</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SDECI</name>
							<description>Set DECI Flag   SDECI</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SDTFI</name>
							<description>Set DTFI Flag   SDTFI</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>write-only</access>

							<resetValue>268435456</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>NCL</name>
									<description>Numerator Configuration Low   NCL. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set. Write access to the TUR Numerator Configuration Low is only possible        during configuration with TURCF.ELT     8216 0  8217  or if TTOCF.EECS  external        clock synchronization enabled  is set. When a new value for NCL is        written outside TT Configuration Mode  the new value takes effect when        TTOST.WECS is cleared to   8216 0  8217 . NCL is locked TTOST.WECS is   8216 1  8217 . If NC  160  lt   160 7  160 x  160 DC in TTCAN Level 1  then it is required that subsequent          time marks in the Trigger Memory must differ by at least 2 NTU.</description>
									<lsb>0</lsb>
									<msb>15</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>DC</name>
									<description>Denominator Configuration   DC. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set.</description>
									<lsb>16</lsb>
									<msb>29</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>ELT</name>
									<description>Enable Local Time   ELT. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set. Local time is started by setting ELT. It remains active until ELT is          reset or until the next hardware reset. TURCF.DC is locked when          TURCF.ELT     8216 1  8217 . If ELT is written to   8216 0  8217   the readable value will          stay at   8216 1  8217  until the new value has been synchronized into the CAN          clock domain. During this time write access to the other bits of the          register remains locked.</description>
									<lsb>31</lsb>
									<msb>31</msb>
									<access>read-write</access>
								</field>
							</fields>
						</register>
						<register>
							<name>TTOCNi</name>
							<description>TT Operation Control 0
 resetvalue={Application Reset:0x0}</description>
							<addressOffset>20</addressOffset>
							<size>32</size>
							<resetValue>0</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>SGT</name>
									<description>Set Global time   SGT. Writing a   8216 1  8217  to SGT sets TTOST.WGDT if the node is the actual Time        Master. SGT is reset after one Host clock period. The global time preset        takes effect when the node transmits the next reference message with the        Master Ref Mark modified by the preset value written to TTGTP.</description>
									<lsb>0</lsb>
									<msb>0</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>ECS</name>
									<description>External Clock Synchronization   ECS. Writing a   8216 1  8217  to ECS sets TTOST.WECS if the node is the actual Time        Master. ECS is reset after one Host clock period. The external clock        synchronization takes effect at the start of the next basic cycle.</description>
									<lsb>1</lsb>
									<msb>1</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>SWP</name>
									<description>Stop Watch Polarity   SWP</description>
									<lsb>2</lsb>
									<msb>2</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>SWS</name>
									<description>Stop Watch Source   SWS</description>
									<lsb>3</lsb>
									<msb>4</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>RTIE</name>
									<description>Register Time Mark Interrupt Pulse Enable   RTIE. Register time mark interrupts are configured by register TTTMK. A        register time mark interrupt pulse with the length of one TTCAN clock        period is generated when the time referenced by TTOCN.TMC  cycle  local         or global  equals TTTMK.TM  independent of the synchronization state.</description>
									<lsb>5</lsb>
									<msb>5</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TMC</name>
									<description>Register Time Mark Compare   TMC. When changing the time mark reference  cycle  local  global time   it          is recommended to first write TMC     8220 00  8221   then reconfigure TTTMK  and          finally set TMC to the intended time reference.</description>
									<lsb>6</lsb>
									<msb>7</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TTIE</name>
									<description>Trigger Time Mark Interrupt Pulse Enable   TTIE. External time mark events are configured by trigger memory element TMEX.        A trigger time mark interrupt pulse is generated when the trigger memory        element becomes active  and the M CAN is in synchronization state In Schedule or In Gap.</description>
									<lsb>8</lsb>
									<msb>8</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>GCS</name>
									<description>Gap Control Select   GCS</description>
									<lsb>9</lsb>
									<msb>9</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>FGP</name>
									<description>Finish Gap   FGP. Set by the CPU  reset by each reference message</description>
									<lsb>10</lsb>
									<msb>10</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TMG</name>
									<description>Time Mark Gap   TMG</description>
									<lsb>11</lsb>
									<msb>11</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>NIG</name>
									<description>Next is Gap   NIG. This bit can only be set when the M CAN is the actual Time Master and when it is configured for external        event synchronized time triggered operation  TTOCF.GEN     8216 1  8217  </description>
									<lsb>12</lsb>
									<msb>12</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>ESCN</name>
									<description>External Synchronization Control   ESCN. If enabled the M CAN synchronizes its cycle time phase to an external event signalled by a        rising edge at the event trigger.</description>
									<lsb>13</lsb>
									<msb>13</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>LCKC</name>
									<description>TT Operation Control Register Locked   LCKC. Set by a write access to register TTOCN. Reset when the updated        configuration has been synchronized into the CAN clock domain.</description>
									<lsb>15</lsb>
									<msb>15</msb>
									<access>read-only</access>
								</field>
							</fields>
						</register>

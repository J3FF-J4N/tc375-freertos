					<resetValue>14656</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>INPCC60</name>
							<description>Interrupt Node Pointer for Channel CC6x Interrupts  INPCC6x  x 0 1 2 . This bit field defines the service request output activated due to a set        condition for bit CC6xR  if enabled by bit ENCC6xR  or for bit CC6xF  if        enabled by bit ENCC6xF .</description>
							<lsb>0</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPCC61</name>
							<description>Interrupt Node Pointer for Channel CC6x Interrupts  INPCC6x  x 0 1 2 . This bit field defines the service request output activated due to a set        condition for bit CC6xR  if enabled by bit ENCC6xR  or for bit CC6xF  if        enabled by bit ENCC6xF .</description>
							<lsb>2</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPCC62</name>
							<description>Interrupt Node Pointer for Channel CC6x Interrupts  INPCC6x  x 0 1 2 . This bit field defines the service request output activated due to a set        condition for bit CC6xR  if enabled by bit ENCC6xR  or for bit CC6xF  if        enabled by bit ENCC6xF .</description>
							<lsb>4</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPCHE</name>
							<description>Interrupt Node Pointer for the CHE Interrupt   INPCHE. This bit field defines the service request output activated due to a set condition for bit CHE  if enabled by bit ENCHE  of for bit STR  if enabled by bit ENSTR . Coding see INPCC6x.</description>
							<lsb>6</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPERR</name>
							<description>Interrupt Node Pointer for Error Interrupts   INPERR. This bit field defines the service request output activated due to a set        condition for bit TRPF  if enabled by bit ENTRPF  or for bit WHE  if        enabled by bit ENWHE . Coding see INPCC6x.</description>
							<lsb>8</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPT12</name>
							<description>Interrupt Node Pointer for Timer12 Interrupts   INPT12. This bit field defines the service request output activated due to a set condition for bit T12OM  if enabled by bit ENT12OM  or for bit T12PM  if enabled by bit ENT12PM . Coding see INPCC6x.</description>
							<lsb>10</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPT13</name>
							<description>Interrupt Node Pointer for Timer13 Interrupt   INPT13. This bit field defines the service request output activated due to a set condition for bit T13CM  if enabled by bit ENT13CM  or for bit T13PM  if enabled by bit ENT13PM . Coding see INPCC6x.</description>
							<lsb>12</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>

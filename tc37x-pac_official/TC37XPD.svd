						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>DATA</name>
								<description>Data Part of the Payload of a Write Frame   DATA. For 8 bit and16 bit write command frames  the whole frame payload width of 32 bit is automatically filled with copies of the lower 8 bits or 16 bits of the register.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>ICONx</name>
						<description>Initiator Control Data Register 0
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>4</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>IDQ</name>
								<description>Read ID Request   IDQ. This bit provides the only way to request a read ID frame. Reads always 0. Write of 1 commences a request. In case of parallel write of 1 to TQ and IDQ  the IDQ request has higher priority.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>TQ</name>
								<description>Trigger Request   TQ. This bit provides an alternative way to request a trigger frame  without having to write to the channel address register. Reads always 0. Write of 1 commences a request. In case of parallel write of 1 to TQ and IDQ  the IDQ request has higher priority.</description>
								<lsb>1</lsb>
								<msb>1</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>LETT</name>
								<description>Last Error Transaction Tag   LETT</description>
								<lsb>2</lsb>
								<msb>4</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CETT</name>
								<description>Currently Expected Transaction Tag   CETT</description>
								<lsb>5</lsb>
								<msb>7</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>TOCV</name>
								<description>Time Out Current Value   TOCV</description>
								<lsb>8</lsb>
								<msb>15</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>DATLEN</name>
								<description>Data Length   DATLEN. Defines the length of the data in bits of the write and read command.</description>
								<lsb>16</lsb>
								<msb>17</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>RWT</name>
								<description>Read Write Trigger Command Type   RWT. Defines if the write to the IRWA register will trigger read  write or trigger request.</description>
								<lsb>18</lsb>
								<msb>19</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>BSY</name>
								<description>Channel Busy   BSY</description>
								<lsb>20</lsb>
								<msb>20</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>ITTAG</name>
								<description>Initiator Transaction Tag   ITTAG. This bit displays the current value of the three bit counter generating the new transaction tag value.</description>
								<lsb>21</lsb>
								<msb>23</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>TOREL</name>
								<description>Time Out Reload Value   TOREL. Defines the duration of the timeout in units of prescaled clock periods. This parameter is valid both in command and stream mode of the channel 2.</description>
								<lsb>24</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>

						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CURRENT</name>
								<description>Current Instruction Pointer   CURRENT. To help debugging  the last valid value is kept when the TriCore stops executing. The value 0000 0000 indicates that no valid IP was ever seen.</description>
								<lsb>1</lsb>
								<msb>31</msb>
								<access>read-only</access>
							</field>

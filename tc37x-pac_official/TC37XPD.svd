					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>XORMASK</name>
							<description>Value to be XORed with the Calculated CRC   XORMASK. Used for error injection  160    160 test purposes.</description>
							<lsb>0</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>XEN</name>
							<description>Enable the Error Injection via XORMASK   XEN</description>
							<lsb>16</lsb>

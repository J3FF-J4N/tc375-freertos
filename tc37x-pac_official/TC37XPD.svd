									<lsb>2</lsb>
									<msb>15</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>EFS</name>
									<description>Event FIFO Size   EFS. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set. The Tx Event FIFO elements are indexed from 0 to EFS   1</description>
									<lsb>16</lsb>
									<msb>21</msb>
									<access>read-write</access>
									<enumeratedValues>

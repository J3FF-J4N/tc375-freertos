					<fields>
						<field>
							<name>LCKHSMUCB</name>
							<description>Lock Access to UCB HSMCFG   LCKHSMUCB. Trap door register. This field can only be written to the   x201c Locked  x201d  state. Other writes are ignored.</description>
							<lsb>0</lsb>
							<msb>1</msb>
							<access>read-write</access>
							<enumeratedValues>
								<enumeratedValue>
									<name>Locked0</name>
									<description>00 Locked Reads to UCB HSMCFG forbidden.</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>Unlocked1</name>
									<description>01 Unlocked Reads by HSM to UCB HSMCFG allowed.</description>
									<value>1</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>Locked2</name>
									<description>10 Locked Reads to UCB HSMCFG forbidden.</description>
									<value>2</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>Locked3</name>

								</field>
								<field>
									<name>NDTB</name>
									<description>Number of Dedicated Transmit Buffers   NDTB. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set. Be aware that the sum of TFQS and NDTB may be not greater than 32.          There is no check for erroneous configurations. The Tx Buffers section          in the Message RAM starts with the dedicated Tx Buffers.</description>
									<lsb>16</lsb>
									<msb>21</msb>
									<access>read-write</access>
									<enumeratedValues>
										<enumeratedValue>
											<name>rest63</name>
											<description>32 Dedicated Tx Buffers</description>
											<value>63</value>
										</enumeratedValue>
									</enumeratedValues>
								</field>
								<field>
									<name>TFQS</name>
									<description>Transmit FIFO Queue Size   TFQS. This bitfield is CCE and INIT protected. Writes will only have effect         if both bits are set.</description>
									<lsb>24</lsb>
									<msb>29</msb>
									<access>read-write</access>
									<enumeratedValues>
										<enumeratedValue>
											<name>rest63</name>
											<description>32 Tx Buffers used for Tx FIFO Queue</description>
											<value>63</value>
										</enumeratedValue>
									</enumeratedValues>
								</field>
								<field>
									<name>TFQM</name>
									<description>Tx FIFO Queue Mode   TFQM. This bitfield is CCE and INIT protected. Writes will only have effect  if both bits are set.</description>
									<lsb>30</lsb>
									<msb>30</msb>
									<access>read-write</access>
								</field>
							</fields>
						</register>
						<register>
							<name>TXFQSi</name>
							<description>Tx FIFO Queue Status 0
 resetvalue={Application Reset:0x0}</description>
							<addressOffset>4</addressOffset>
							<size>32</size>
							<resetValue>0</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>TFFL</name>
									<description>Tx FIFO Free Level   TFFL. Number of consecutive free Tx FIFO elements starting from TFGI  range 0        to 32. Read as zero when Tx Queue operation is configured  TXBC.TFQM            8216 1  8217   In case of mixed configurations where dedicated Tx Buffers are          combined with a Tx FIFO or a Tx Queue  the Put and Get Indices          indicate the number of the Tx Buffer starting with the first dedicated          Tx Buffers. Example  For a configuration of 12 dedicated Tx Buffers          and a Tx FIFO of 20 Buffers a Put Index of 15 points to the fourth          buffer of the Tx FIFO.</description>
									<lsb>0</lsb>
									<msb>5</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>TFGI</name>
									<description>Tx FIFO Get Index   TFGI. Tx FIFO read index pointer  range 0 to 31. Read as zero when Tx Queue   operation is configured  TXBC.TFQM    1  .</description>
									<lsb>8</lsb>
									<msb>12</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>TFQPI</name>
									<description>Tx FIFO Queue Put Index   TFQPI. Tx FIFO Queue write index pointer  range 0 to 31.</description>
									<lsb>16</lsb>
									<msb>20</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>TFQF</name>
									<description>Tx FIFO Queue Full   TFQF</description>
									<lsb>21</lsb>
									<msb>21</msb>
									<access>read-only</access>
								</field>

							<resetValue>4128768</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>CT</name>
									<description>Cycle Time   CT. Non fractional part of the difference of the node  8217 s local time and        Ref Mark. Cycle time value of TTCAN Basic Cycle</description>
									<lsb>0</lsb>
									<msb>15</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>CC</name>
									<description>Cycle Count   CC. Number of actual Basic Cycle in the System Matrix</description>
									<lsb>16</lsb>
									<msb>21</msb>
									<access>read-only</access>
								</field>
							</fields>

								<lsb>9</lsb>
								<msb>9</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF10</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>10</lsb>
								<msb>10</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF11</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>11</lsb>
								<msb>11</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF12</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>12</lsb>
								<msb>12</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF13</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>13</lsb>
								<msb>13</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF14</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>14</lsb>
								<msb>14</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF22</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>22</lsb>
								<msb>22</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CF23</name>
								<description>Configuration flag x  x 0 2  for alarm 31 belonging to alarm group i.   CF31. The configuration flags 0  1 and 2 must be used together to define the        behavior of the SMU core when a fault state is reported by the alarm n        belonging to this group.</description>
								<lsb>23</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>

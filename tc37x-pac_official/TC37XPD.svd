							<description>CPU Select 0   CSEL0. Return 0 if read.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>CSEL1</name>
							<description>CPU Select 1  If product has CPU1    CSEL1. Return 0 if read.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>CSEL2</name>
							<description>CPU Select 2  If product has CPU2    CSEL2. Return 0 if read.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>OVSTRT</name>
							<description>Overlay Start   OVSTRT. CPUs which are not selected are not affected. No action is taken if OVSTP is also set. Return 0 if read.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>OVSTP</name>
							<description>Overlay Stop   OVSTP. CPUs which are not selected are not affected No action is taken if OVSTRT is also set. Return 0 if read.</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>DCINVAL</name>
							<description>Data Cache Invalidate   DCINVAL. No function in devices without data cache in CPU. This bit  when set  generates a pulse on signal ... ovc dcinval. Data Cache is affected only in the CPUs selected with CSEL. Return 0 if read.</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>OVCONF</name>
							<description>Overlay Configured   OVCONF. Overlay configured status bit This bit may be used as handshake bit between a debug device  via JTAG        interface and Cerberus  and CPU s .</description>
							<lsb>24</lsb>
							<msb>24</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>POVCONF</name>
							<description>Write Protection for OVCONF   POVCONF. This bit enables OVCONF write during OVCCON write. Return 0 if read.</description>
							<lsb>25</lsb>
							<msb>25</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>

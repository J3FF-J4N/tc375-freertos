							<name>BR_VALUE</name>
							<description>Baud Rate Timer Reload Register Value   BR VALUE. Reading BR VALUE returns the 13 bit content of the baud rate timer. Writing BR VALUE loads the baud rate timer reload register. BG should only be written if CON.R   0.</description>
							<lsb>0</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FDV</name>

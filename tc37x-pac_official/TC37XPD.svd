							<access>read-only</access>
						</field>
						<field>
							<name>DPWMOUT</name>
							<description>DPWM Control Output Status   DPWMOUT. This bit field reflects the actual PWM output of the controller provided        to the external MOSFET switches.</description>
							<lsb>16</lsb>
							<msb>27</msb>
							<access>read-only</access>

						<field>
							<name>OE</name>
							<description>SEI Timeout Overflow Error Status Flag   OE. This bit is set when SEISR.TIM overflows from FFFF H to FFFC H . This bit is only cleared on        a valid SEICON0 Modify Access.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>

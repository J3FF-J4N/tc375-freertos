							<lsb>11</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>BACKMONTST</name>
							<description>Backup Clock Monitor Test   BACKMONTST. The test enable bit is not a direct trigger for the alarm  but an inhibit for the clock to be monitored. This is to test the monitoring logic itself as well.</description>
							<lsb>12</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>UP</name>
							<description>Update Request   UP. Setting this bit will request an update for CCUCON3 and CCUCON4. Only one UP bit must be set for either CCUCON3 or CCUCON4. This bit always reads as zero.</description>
							<lsb>30</lsb>
							<msb>30</msb>

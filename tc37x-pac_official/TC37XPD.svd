					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>TM</name>
							<description>Transmission Mode   TM. This bit selects the transmission mode of the downstream channel.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CP</name>
							<description>Command Pending   CP. This bit is set when the downstream command register DC is written. CP        is cleared when the first bit of the related command frame is sent out.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>DP</name>
							<description>Data Pending   DP. In Triggered Mode  this bit is set when the set data pending bit ISC.SDP        is set by software. In Data Repetition Mode  this bit is set by hardware        at the last passive time frame. At the start of the data frame  DP is        cleared by hardware.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>NDBL</name>
							<description>Number of SRL Bits Shifted at Data Frames   NDBL. NDBL determines the number of shift register low part  SRL  bits that        are shifted out on SO during a data frame. Other bit combinations are        reserved  do not use these bit combinations.</description>
							<lsb>3</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>NDBH</name>
							<description>Number of SRH Bits Shifted at Data Frames   NDBH. NDBH determines the number of shift register high part  SRH  bits that        are shifted out on SO during a data frame. Other bit combinations are        reserved  do not use these bit combinations.</description>
							<lsb>8</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ENSELL</name>
							<description>Enable SRL Active Phase Selection Bit   ENSELL. This bit determines whether a low level selection bit is inserted at the        beginning of a data frame  8217 s SRL active phase.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>

				</register>
				<register>
					<name>FLAGSCLEAR</name>
					<description>Flags Clear Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>60</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>THC</name>
							<description>Flag Clear Bit   THC. Write of   8220 1  8221  in this bit clears the bit at the corresponding position in        the FLAGS register.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>

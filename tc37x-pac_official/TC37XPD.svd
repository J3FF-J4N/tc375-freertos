						<field>
							<name>T13IM</name>
							<description>T13 Inverted Modulation   T13IM. Bit T13IM inverts the T13 signal for the modulation of the CC6x and COUT6x  x   0  1  2  signals.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CMPMODIF</name>
					<description>Compare State Modification Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>100</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MCC60S</name>
							<description>Capture Compare Status Modification Bits MCC62S  x   0  1  2    MCC62S. These bits are used to set the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC61S</name>
							<description>Capture Compare Status Modification Bits MCC62S  x   0  1  2    MCC62S. These bits are used to set the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC62S</name>
							<description>Capture Compare Status Modification Bits MCC62S  x   0  1  2    MCC62S. These bits are used to set the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC63S</name>
							<description>Capture Compare Status Modification Bit MCC63S   MCC63S. This bit is used to set the corresponding bit CC63ST by SW. The functionality of a write access to bits concerning the same capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC60R</name>
							<description>Capture Compare Status Modification Bits MCC62R  x   0  1  2    MCC62R. These bits are used to clear the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC61R</name>
							<description>Capture Compare Status Modification Bits MCC62R  x   0  1  2    MCC62R. These bits are used to clear the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC62R</name>
							<description>Capture Compare Status Modification Bits MCC62R  x   0  1  2    MCC62R. These bits are used to clear the corresponding bits CC6xST by SW. The functionality of a write access to bits concerning the same        capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>MCC63R</name>
							<description>Capture Compare Status Modification Bits MCC63R   MCC63R. This bit is used to clear the corresponding bit CC63ST by SW. The functionality of a write access to bits concerning the same capture compare state bit is shown in CROSSREFERENCE .</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>T12MSEL</name>
					<description>T12 Mode Select Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>104</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MSEL60</name>
							<description>Capture Compare Mode Selection MSEL6x  x 0 1 2 . These bit fields select the operating mode of the three T12        capture compare channels. Each channel  x   0  1  2  can be programmed        individually for one of these modes  except for Hall Sensor Mode .        Coding see CROSSREFERENCE .</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MSEL61</name>
							<description>Capture Compare Mode Selection MSEL6x  x 0 1 2 . These bit fields select the operating mode of the three T12        capture compare channels. Each channel  x   0  1  2  can be programmed        individually for one of these modes  except for Hall Sensor Mode .        Coding see CROSSREFERENCE .</description>
							<lsb>4</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MSEL62</name>
							<description>Capture Compare Mode Selection MSEL6x  x 0 1 2 . These bit fields select the operating mode of the three T12        capture compare channels. Each channel  x   0  1  2  can be programmed        individually for one of these modes  except for Hall Sensor Mode .        Coding see CROSSREFERENCE .</description>
							<lsb>8</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>HSYNC</name>
							<description>Hall Synchronization   HSYNC. Bit field HSYNC defines the source for the sampling of the Hall input        pattern and the comparison to the current and the expected Hall pattern        bit fields. Coding see CROSSREFERENCE .</description>
							<lsb>12</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DBYP</name>
							<description>Delay Bypass   DBYP. DBYP controls whether the source signal for the sampling of the Hall        input pattern  selected by HSYNC  is delayed by the Dead Time Counter 0.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TCTR0</name>
					<description>Timer Control Register 0
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>112</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>T12CLK</name>
							<description>Timer T12 Input Clock Select   T12CLK. Selects the input clock for timer T12 that is derived from the peripheral clock according to the equation f T12   f CC6   2  lt T12CLK gt  .</description>
							<lsb>0</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T12PRE</name>
							<description>Timer T12 Prescaler Bit   T12PRE. In order to support higher clock frequencies  an additional prescaler factor of 1 256 can be enabled for the prescaler for T12.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T12R</name>
							<description>Timer T12 Run Bit   T12R. T12R starts and stops timer T12. It is set cleared by SW by setting bits T12RR or T12RS or it is cleared by HW according to the function defined by bit field T12SSC.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>STE12</name>
							<description>Timer T12 Shadow Transfer Enable   STE12. Bit STE12 enables or disables the shadow transfer of the T12 period value  the compare values and passive state select bits and levels from their shadow registers to the actual registers if a T12 shadow transfer event is detected. Bit STE12 is cleared by hardware after the shadow transfer. A T12 shadow transfer event is a period match while counting up or a one match while counting down.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CDIR</name>
							<description>Count Direction of Timer T12   CDIR. This bit is set cleared according to the counting rules of T12.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CTM</name>
							<description>T12 Operating Mode   CTM</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13CLK</name>
							<description>Timer T13 Input Clock Select   T13CLK. Selects the input clock for timer T13 that is derived from the peripheral clock according to the equation f T13   f CC6   2  lt T13CLK gt  .</description>
							<lsb>8</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13PRE</name>
							<description>Timer T13 Prescaler Bit   T13PRE. In order to support higher clock frequencies  an additional prescaler factor of 1 256 can be enabled for the prescaler for T13.</description>
							<lsb>11</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13R</name>
							<description>Timer T13 Run Bit   T13R. T13R starts and stops timer T13. It is set cleared by SW by setting bits T13RR orT13RS or it is set cleared by HW according to the function defined by bit fields T13SSC  T13TEC and T13TED.</description>
							<lsb>12</lsb>
							<msb>12</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>STE13</name>
							<description>Timer T13 Shadow Transfer Enable   STE13. Bit STE13 enables or disables the shadow transfer of the T13 period value  the compare value and passive state select bit and level from their shadow registers to the actual registers if a T13 shadow transfer event is detected. Bit STE13 is cleared by hardware after the shadow transfer. A T13 shadow transfer event is a period match.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TCTR2</name>
					<description>Timer Control Register 2
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>116</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>T12SSC</name>
							<description>Timer T12 Single Shot Control   T12SSC. This bit controls the single shot mode of T12.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13SSC</name>
							<description>Timer T13 Single Shot Control   T13SSC. This bit controls the single shot mode of T13.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13TEC</name>
							<description>T13 Trigger Event Control   T13TEC. Bit field T13TEC selects the trigger event to start T13  automatic set of T13R for synchronization to T12 compare signals  according to following combinations </description>
							<lsb>2</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13TED</name>
							<description>Timer T13 Trigger Event Direction   T13TED. Bit field T13TED delivers additional information to control the automatic set of bit T13R in the case that the trigger action defined by T13TEC is detected.</description>
							<lsb>5</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T12RSEL</name>
							<description>Timer T12 External Run Selection   T12RSEL. Bit field T12RSEL defines the event of signal T12HR that can set the run bit T12R by HW.</description>
							<lsb>8</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13RSEL</name>
							<description>Timer T13 External Run Selection   T13RSEL. Bit field T13RSEL defines the event of signal T13HR that can set the run bit T13R by HW.</description>
							<lsb>10</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TCTR4</name>
					<description>Timer Control Register 4
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>120</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>T12RR</name>
							<description>Timer T12 Run Reset   T12RR. Setting this bit clears the T12R bit.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T12RS</name>
							<description>Timer T12 Run Set   T12RS. Setting this bit sets the T12R bit.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T12RES</name>
							<description>Timer T12 Reset   T12RES</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>DTRES</name>
							<description>Dead Time Counter Reset   DTRES</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T12CNT</name>
							<description>Timer T12 Count Event   T12CNT</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T12STR</name>
							<description>Timer T12 Shadow Transfer Request   T12STR</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T12STD</name>
							<description>Timer T12 Shadow Transfer Disable   T12STD</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13RR</name>
							<description>Timer T13 Run Reset   T13RR. Setting this bit clears the T13R bit.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13RS</name>
							<description>Timer T13 Run Set   T13RS. Setting this bit sets the T13R bit.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13RES</name>
							<description>Timer T13 Reset   T13RES</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13CNT</name>
							<description>Timer T13 Count Event   T13CNT</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13STR</name>
							<description>Timer T13 Shadow Transfer Request   T13STR</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13STD</name>
							<description>Timer T13 Shadow Transfer Disable   T13STD</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MODCTR</name>
					<description>Modulation Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>128</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>T12MODEN</name>
							<description>T12 Modulation Enable   T12MODEN. These bits enable the modulation of the corresponding output signal by a PWM pattern generated by timer T12. T12MODEN0   MODCTR.0 for output CC60 T12MODEN1   MODCTR.1 for output COUT60 T12MODEN2   MODCTR.2 for output CC61 T12MODEN3   MODCTR.3 for output COUT61 T12MODEN4   MODCTR.4 for output CC62 T12MODEN5   MODCTR.5 for output COUT62</description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MCMEN</name>
							<description>Multi Channel Mode Enable   MCMEN</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13MODEN</name>
							<description>T13 Modulation Enable   T13MODEN. These bits enable the modulation of the corresponding output signal by the PWM pattern CC63 O generated by timer T13. T13MODEN0   MODCTR.8 for output CC60 T13MODEN1   MODCTR.9 for output COUT60 T13MODEN2   MODCTR.10 for output CC61 T13MODEN3   MODCTR.11 for output COUT61 T13MODEN4   MODCTR.12 for output CC62 T13MODEN5   MODCTR.13 for output COUT62</description>
							<lsb>8</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ECT13O</name>
							<description>Enable Compare Timer T13 Output   ECT13O</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TRPCTR</name>
					<description>Trap Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>132</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>TRPM0</name>
							<description>Trap Mode Control Bit 0   TRPM0. Together with bit TRPM1  these two bits define the behavior of the        selected outputs when leaving the trap state after the trap condition        has become inactive again. A synchronization to the timer driving the        PWM pattern avoids unintended pulses when leaving the trap state. The        behavior resulting from the combination  TRPM1  TRPM0  is described in CROSSREFERENCE .</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRPM1</name>
							<description>Trap Mode Control Bit 1   TRPM1. Together with bit TRPM0  these two bits define the behavior of the        selected outputs when leaving the trap state after the trap condition        has become inactive again. A synchronization to the timer driving the        PWM pattern avoids unintended pulses when leaving the trap state. The        behavior resulting from the combination  TRPM1  TRPM0  is described in CROSSREFERENCE .</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRPM2</name>
							<description>Trap Mode Control Bit 2   TRPM2. This bit defines how the trap flag TRPF can be cleared after the trap        input condition   CTRAP   160    160 0        and TRPPEN  160    160 1  is no longer valid  either by CTRAP   160    160 1        or by TRPPEN  160    160 0 .</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRPEN</name>
							<description>Trap Enable Control   TRPEN. Setting a bit enables the trap functionality for the following corresponding output signals  TRPEN0   TRPCTR.8 for output CC60 TRPEN1   TRPCTR.9 for output COUT60 TRPEN2   TRPCTR.10 for output CC61 TRPEN3   TRPCTR.11 for output COUT61 TRPEN4   TRPCTR.12 for output CC62 TRPEN5   TRPCTR.13 for output COUT62</description>
							<lsb>8</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRPEN13</name>
							<description>Trap Enable Control for Timer T13   TRPEN13</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRPPEN</name>
							<description>Trap Pin Enable   TRPPEN. This bit enables the input  pin  function for the trap generation. An interrupt can only be generated if a falling edge is detected at pin CTRAP while TRPPEN   1.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>PSLR</name>
					<description>Passive State Level Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>136</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>PSL</name>
							<description>Compare Outputs Passive State Level   PSL. These bits define the passive level driven by the module outputs during the passive state. PSL0   PSLR.0 for output CC60 PSL1   PSLR.1 for output COUT60 PSL2   PSLR.2 for output CC61 PSL3   PSLR.3 for output COUT61 PSL4   PSLR.4 for output CC62 PSL5   PSLR.5 for output COUT62</description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>PSL63</name>
							<description>Passive State Level of Output COUT63   PSL63. This bit defines the passive level driven by the module output COUT63 during the passive state.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MCMOUTS</name>
					<description>Multi Channel Mode Output Shadow Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>140</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MCMPS</name>
							<description>Multi Channel PWM Pattern Shadow   MCMPS. Bit field MCMPS is the shadow bit field for bit field MCMP. The multi channel shadow transfer is triggered by MCM ST according to the transfer conditions defined by register MCMCTR.</description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STRMCM</name>
							<description>Shadow Transfer Request for MCMPS   STRMCM. Writing STRMCM  160    160 1 leads to an immediate activation of MCM ST to update        bit field MCMP by the value of MCMPS. When read  this bit always        delivers 0.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>EXPHS</name>
							<description>Expected Hall Pattern Shadow   EXPHS. Bit field EXPHS is the shadow bit field for bit field EXPH. The shadow transfer takes place when a correct Hall event is detected  CM CHE .</description>
							<lsb>8</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CURHS</name>
							<description>Current Hall Pattern Shadow   CURHS. Bit field CURHS is the shadow bit field for bit field CURH. The shadow transfer takes place when a correct Hall event is detected  CM CHE .</description>
							<lsb>11</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STRHP</name>
							<description>Shadow Transfer Request for the Hall Pattern   STRHP. Writing STRHP   1 leads to an immediate activation of HP ST to update bit fields EXPH and CURH by EXPHS and CURHS. When read  this bit always delivers 0.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MCMOUT</name>
					<description>Multi Channel Mode Output Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>144</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MCMP</name>
							<description>Multi Channel PWM Pattern   MCMP. Bit field MCMP defines the output pattern for the multi channel mode. If this mode is enabled by MODCTR.MCMEN   1  the output state of all T12 related PWM outputs can be modified. This bit field is 0 while IS.IDLE   1. MCMP0   MCMOUT.0 for output CC60 MCMP1   MCMOUT.1 for output COUT60 MCMP2   MCMOUT.2 for output CC61 MCMP3   MCMOUT.3 for output COUT61 MCMP4   MCMOUT.4 for output CC62 MCMP5   MCMOUT.5 for output COUT62</description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>R</name>
							<description>Reminder Flag   R. This flag indicates that the shadow transfer from MCMPS to MCMP has been requested by the selected trigger source. It is cleared when the shadow transfer takes place or while MCMEN 0.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>EXPH</name>
							<description>Expected Hall Pattern   EXPH. Bit field EXPH is updated by a shadow transfer HP ST from bit field EXPHS. If HCRDY   1  EXPH is compared to the sampled CCPOSx inputs in order to detect the occurrence of the next desired   expected  hall pattern or a wrong pattern. If the sampled hall pattern at the hall input pins is equal to bit field EXPH  a correct Hall event has been detected  CM CHE .</description>
							<lsb>8</lsb>
							<msb>10</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CURH</name>
							<description>Current Hall Pattern   CURH. Bit field CURH is updated by a shadow transfer HP ST from bit field CURHS. If HCRDY   1  CURH is compared to the sampled CCPOSx inputs in order to detect a spike. If the sampled Hall pattern at the Hall input pins is equal to bit field CURH  no Hall event has been detected. If the sampled Hall input pattern is neither equal to CURH nor equal to EXPH  the Hall event was not the desired one and may be due to a fatal error  e.g. blocked rotor  etc. . In this case  a wrong Hall event has been detected  CM WHE .</description>
							<lsb>11</lsb>
							<msb>13</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MCMCTR</name>
					<description>Multi Channel Mode Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>148</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>SWSEL</name>
							<description>Switching Selection   SWSEL. Bit field SWSEL selects one of the following trigger request sources  next multi channel event  for the shadow transfer MCM ST from MCMPS to MCMP. The trigger request is stored in the reminder flag R until the shadow transfer is done and flag R is cleared automatically with the shadow transfer. The shadow transfer takes place synchronously with an event selected in bit field SWSYN.</description>
							<lsb>0</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SWSYN</name>
							<description>Switching Synchronization   SWSYN. Bit field SWSYN defines the synchronization mechanism of the shadow transfer event MCM ST if it has been requested before  flag R set by an event selected by SWSEL  and if MCMEN   1. This feature permits the synchronization of the outputs to the PWM source  that is used for modulation  T12 or T13 .</description>
							<lsb>4</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STE12U</name>
							<description>Shadow Transfer Enable for T12 Upcounting   STE12U. This bit enables the shadow transfer T12 ST if flag MCMOUT.R is set or becomes set while a T12 period match is detected while counting up.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STE12D</name>
							<description>Shadow Transfer Enable for T12 Downcounting   STE12D. This bit enables the shadow transfer T12 ST if flag MCMOUT.R is set or becomes set while a T12 one match is detected while counting down.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>STE13U</name>
							<description>Shadow Transfer Enable for T13 Upcounting   STE13U. This bit enables the shadow transfer T13 ST if flag MCMOUT.R is set or becomes set while a T13 period match is detected.</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>IMON</name>
					<description>Input Monitoring Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>152</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>LBE</name>
							<description>Lost Bit Event   LBE. This bit determines if a lost bit event has occurred. A lost bit event        occurs when a selected event occurs again with the previous event        captured  IMON.x remains set  and its lost indicator is enabled  for at        least one of the monitored input signals. The bit can be cleared by        writing a 1 to the same bit position  while writing a 0 has no effect.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCPOS0I</name>
							<description>Event indication for input signal CCPOS2   CCPOS2I. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect. The dedicated edge is indicated for a selected event if          Hysteretic like Control or Capture modes are initialized in          T12MSEL.MSEL6x. If these modes are not selected  then all edges will          be indicated as an event for the inputs.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCPOS1I</name>
							<description>Event indication for input signal CCPOS2   CCPOS2I. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect. The dedicated edge is indicated for a selected event if          Hysteretic like Control or Capture modes are initialized in          T12MSEL.MSEL6x. If these modes are not selected  then all edges will          be indicated as an event for the inputs.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCPOS2I</name>
							<description>Event indication for input signal CCPOS2   CCPOS2I. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect. The dedicated edge is indicated for a selected event if          Hysteretic like Control or Capture modes are initialized in          T12MSEL.MSEL6x. If these modes are not selected  then all edges will          be indicated as an event for the inputs.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC60INI</name>
							<description>Event indication for input signal CC62IN   CC62INI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC61INI</name>
							<description>Event indication for input signal CC62IN   CC62INI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC62INI</name>
							<description>Event indication for input signal CC62IN   CC62INI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CTRAPI</name>
							<description>Event indication for input signal CTRAP   CTRAPI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T12HRI</name>
							<description>Event indication for input signal T12HR   T12HRI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13HRI</name>
							<description>Event indication for input signal T13HR   T13HRI. The bit determines if the selected event has occurred via an edge        detection. The bit can be cleared by writing a 1 to the same bit        position  while writing a 0 has no effect.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>LI</name>
					<description>Lost Indicator Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>156</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>CCPOS0EN</name>
							<description>Lost Indicator Enable for input signal CCPOS2   CCPOS2EN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCPOS1EN</name>
							<description>Lost Indicator Enable for input signal CCPOS2   CCPOS2EN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCPOS2EN</name>
							<description>Lost Indicator Enable for input signal CCPOS2   CCPOS2EN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC60INEN</name>
							<description>Lost Indicator Enable for input signal CC62IN   CC62INEN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC61INEN</name>
							<description>Lost Indicator Enable for input signal CC62IN   CC62INEN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CC62INEN</name>
							<description>Lost Indicator Enable for input signal CC62IN   CC62INEN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CTRAPEN</name>
							<description>Lost Indicator Enable for input signal CTRAP   CTRAPEN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T12HREN</name>
							<description>Lost Indicator Enable for input signal T12HR   T12HREN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>T13HREN</name>
							<description>Lost Indicator Enable for input signal T13HR   T13HREN. This bit determines if the monitored event at the input signal is enabled for the detection of a lost bit event.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>LBEEN</name>
							<description>Interrupt Enable for Lost Bit Event   LBEEN. This bit determines if a SRx line is activated if lost bit event is detected.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INPLBE</name>
							<description>Interrupt Node Pointer for lost bit event   INPLBE. This bit field defines which service request output line is selected to output an lost event alert for an enabled lost bit event.</description>
							<lsb>14</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>IS</name>
					<description>Interrupt Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>160</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>ICC60R</name>
							<description>Capture  Compare Match Rising Edge Flag ICC6xR  x 0 1 2 . This bit indicates that event CC6x R has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting up  CM 6x and CDIR  160    160 0  and in capture mode when a rising edge        is detected at the related input CC6xIN.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ICC60F</name>
							<description>Capture  Compare Match Falling Edge Flag ICC6xF  x 0 1 2  . This bit indicates that event CC6x F has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting down  CM 6x and CDIR  160    160 1  and in capture mode when a falling        edge is detected at the related input CC6xIN.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ICC61R</name>
							<description>Capture  Compare Match Rising Edge Flag ICC6xR  x 0 1 2 . This bit indicates that event CC6x R has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting up  CM 6x and CDIR  160    160 0  and in capture mode when a rising edge        is detected at the related input CC6xIN.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ICC61F</name>
							<description>Capture  Compare Match Falling Edge Flag ICC6xF  x 0 1 2  . This bit indicates that event CC6x F has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting down  CM 6x and CDIR  160    160 1  and in capture mode when a falling        edge is detected at the related input CC6xIN.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ICC62R</name>
							<description>Capture  Compare Match Rising Edge Flag ICC6xR  x 0 1 2 . This bit indicates that event CC6x R has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting up  CM 6x and CDIR  160    160 0  and in capture mode when a rising edge        is detected at the related input CC6xIN.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ICC62F</name>
							<description>Capture  Compare Match Falling Edge Flag ICC6xF  x 0 1 2  . This bit indicates that event CC6x F has been detected. This event        occurs in compare mode when a compare match is detected while T12 is        counting down  CM 6x and CDIR  160    160 1  and in capture mode when a falling        edge is detected at the related input CC6xIN.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>T12OM</name>
							<description>Timer T12 One Match Flag   T12OM. This bit indicates that a timer T12 one match while counting down  T12 OM and CDIR   1  has been detected.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>T12PM</name>
							<description>Timer T12 Period Match Flag   T12PM. This bit indicates that a timer T12 period match while counting up  T12 PM and CDIR   0  has been detected.</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>T13CM</name>
							<description>Timer T13 Compare Match Flag   T13CM. This bit indicates that a timer T13 compare match  CM 63  has been detected.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>T13PM</name>
							<description>Timer T13 Period Match Flag   T13PM. This bit indicates that a timer T13 period match  T13 PM  has been detected.</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TRPF</name>
							<description>Trap Flag   TRPF. This bit indicates if a trap condition  input CTRAP   0 or by SW  is   has been detected. If TRPM2  0  it becomes cleared automatically if CTRAP   1 or TRPPEN   0  whereas if TRPM2   1  it has to be cleared by writing RTRPF   1.</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>TRPS</name>
							<description>Trap State   TRPS. This bit indicates the actual trap state. It is set if TRPF   1 and becomes cleared according to the mode selected in register TRPCTR.</description>
							<lsb>11</lsb>
							<msb>11</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CHE</name>
							<description>Correct Hall Event   CHE. This bit indicates that a correct Hall event  CM CHE  has been detected.</description>
							<lsb>12</lsb>
							<msb>12</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>WHE</name>
							<description>Wrong Hall Event   WHE. This bit indicates that a wrong Hall event  CM WHE  has been detected.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>IDLE</name>
							<description>IDLE State   IDLE. If enabled by ENIDLE   1  this bit is set together with bit WHE and it has to be cleared by SW.</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>STR</name>
							<description>Multi Channel Mode Shadow Transfer Request   STR. This bit indicates that a shadow transfer from MCMPS to MCMP  MCM ST  has taken place.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ISS</name>
					<description>Interrupt Status Set Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>164</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>SCC60R</name>
							<description>Set Capture  Compare Match Rising Edge Flag   SCC6xR  x 0 1 2 </description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SCC60F</name>
							<description>Set Capture  Compare Match Falling Edge Flag   SCC6xF  x 0 1 2 </description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SCC61R</name>
							<description>Set Capture  Compare Match Rising Edge Flag   SCC6xR  x 0 1 2 </description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SCC61F</name>
							<description>Set Capture  Compare Match Falling Edge Flag   SCC6xF  x 0 1 2 </description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SCC62R</name>
							<description>Set Capture  Compare Match Rising Edge Flag   SCC6xR  x 0 1 2 </description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SCC62F</name>
							<description>Set Capture  Compare Match Falling Edge Flag   SCC6xF  x 0 1 2 </description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>ST12OM</name>
							<description>Set Timer T12 One Match Flag   ST12OM</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>ST12PM</name>
							<description>Set Timer T12 Period Match Flag   ST12PM</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>ST13CM</name>
							<description>Set Timer T13 Compare Match Flag   ST13CM</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>ST13PM</name>
							<description>Set Timer T13 Period Match Flag   ST13PM</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>STRPF</name>
							<description>Set Trap Flag   STRPF</description>

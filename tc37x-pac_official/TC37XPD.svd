					<resetValue>8191</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>TOP</name>
							<description>Trace Buffer upper Bound   TOP. See CROSSREFERENCE for a functional description. The relevant width of the field depends on the size of the buffer memory see CROSSREFERENCE</description>
							<lsb>5</lsb>
							<msb>12</msb>
							<access>read-write</access>

						<fields>
							<field>
								<name>CAT0</name>
								<description>Cancel ARU transfer for channel 7. The CATx  x   0..T 1  bit inside the STA register of the corresponding          MCS channel is set  and any pending blocking ARU read or write request          is canceled. The MCS channel resumes with the instruction after the          blocking ARU transfer instruction. The CATx  x   0..T 1  bit is cleared by the corresponding MCS channel          when the channel is entering a blocking ARU read or write instruction.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-write</access>
							</field>
							<field>

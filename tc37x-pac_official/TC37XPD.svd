							<field>
								<name>AWS</name>
								<description>Access Window Start Address   AWS. This bit field defines the upper 24 bits of the start address of the        corresponding access window. This results in a granularity of 256 bytes        for the start address.</description>
								<lsb>8</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>

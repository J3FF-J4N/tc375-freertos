					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>CLP</name>
							<description>FCLP Line Polarity   CLP</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SLP</name>
							<description>SOP Line Polarity   SLP</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CSLP</name>
							<description>Chip Selection Lines Polarity   CSLP. Bit CSLP is buffered during a frame transmission. This means that any        change of CSLP becomes valid first with the start of the next frame        transmission.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ILP</name>
							<description>SDI Line Polarity   ILP</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CLKCTRL</name>
							<description>Clock Control   CLKCTRL. This bit determines the activation of clock output FCL.</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CSL</name>
							<description>Chip Enable Selection for ENL   CSL. This bit field selects the chip enable output ENx that becomes active        during the SRL active phase  ENL  160    160 1  of a data frame. The active level        of ENx is defined by bit CSLP.</description>
							<lsb>9</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CSH</name>
							<description>Chip Enable Selection for ENH   CSH. This bit field selects the chip enable output ENx that becomes active        during the SRH active phase  ENH  160    160 1  of a data frame. The active level        of ENx is defined by bit CSLP.</description>
							<lsb>11</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CSC</name>
							<description>Chip Enable Selection for ENC   CSC. This bit field selects the chip enable output ENx that becomes active        during the active phase  ENC  160    160 1  of a command frame. The active level        of ENx is defined by bit CSLP.</description>
							<lsb>13</lsb>
							<msb>14</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SDISEL</name>
							<description>Serial Data Input Selection   SDISEL. This bit field selects the source for the serial data input SDI of the        upstream channel.</description>
							<lsb>16</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
					</fields>

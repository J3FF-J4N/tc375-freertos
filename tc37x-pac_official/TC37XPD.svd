							<lsb>9</lsb>
							<msb>9</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T13RES</name>
							<description>Timer T13 Reset   T13RES</description>
							<lsb>10</lsb>
							<msb>10</msb>
							<access>write-only</access>

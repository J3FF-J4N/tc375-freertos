											<lsb>3</lsb>
											<msb>3</msb>
											<access>read-write</access>
										</field>
									</fields>
								</register>
								<register>
									<name>FIFOi_CHz_IRQ_FORCINT</name>
									<description>FIFO0 Channel 0 Force Interrupt Register
 resetvalue={Application Reset:0x0}</description>
									<addressOffset>8</addressOffset>
									<size>32</size>
									<resetValue>0</resetValue>
									<resetMask>4294967295</resetMask>
									<fields>
										<field>
											<name>TRG_FIFO_EMPTY</name>
											<description>Force interrupt of FIFO Empty status. This bit is cleared automatically after write. This bit is write protected by bit RF PROT of register GTM CTRL</description>
											<lsb>0</lsb>
											<msb>0</msb>
											<access>read-write</access>
										</field>
										<field>
											<name>TRG_FIFO_FULL</name>
											<description>Force interrupt of FIFO Full status. This bit is cleared automatically after write. This bit is write protected by bit RF PROT of register GTM CTRL.</description>
											<lsb>1</lsb>
											<msb>1</msb>
											<access>read-write</access>
										</field>
										<field>
											<name>TRG_FIFO_LWM</name>
											<description>Force interrupt of Lower Watermark. This bit is cleared automatically after write. This bit is write protected by bit RF PROT of register GTM CTRL.</description>
											<lsb>2</lsb>
											<msb>2</msb>
											<access>read-write</access>
										</field>
										<field>
											<name>TRG_FIFO_UWM</name>
											<description>Force interrupt of Upper Watermark. This bit is cleared automatically after write. This bit is write protected by bit RF PROT of register GTM CTRL.</description>
											<lsb>3</lsb>
											<msb>3</msb>
											<access>read-write</access>
										</field>
									</fields>
								</register>
								<register>
									<name>FIFOi_CHz_IRQ_MODE</name>
									<description>FIFO0 Channel 0 Interrupt Mode Control Register
 resetvalue={Application Reset:0x0}</description>
									<addressOffset>12</addressOffset>
									<size>32</size>
									<resetValue>0</resetValue>
									<resetMask>4294967295</resetMask>
									<fields>
										<field>
											<name>IRQ_MODE</name>
											<description>IRQ mode selection. The interrupt modes are described in CROSSREFERENCE .</description>
											<lsb>0</lsb>
											<msb>1</msb>
											<access>read-write</access>
										</field>
										<field>
											<name>DMA_HYSTERESIS</name>
											<description>Enable DMA hysteresis mode</description>
											<lsb>2</lsb>
											<msb>2</msb>
											<access>read-write</access>
										</field>
										<field>
											<name>DMA_HYST_DIR</name>
											<description>DMA direction in hysteresis mode. In the case of DMA writing data to a FIFO  the DMA requests must be        generated by the lower watermark. If the DMA hysteresis is enabled  the        FIFO does not generate a new DMA request until the upper watermark is        reached. In the case of DMA reading data from FIFO  the DMA requests must be        generated by the upper watermark. If the DMA hysteresis is enabled  the        FIFO does not generate a new DMA request until the lower watermark is        reached.</description>
											<lsb>3</lsb>
											<msb>3</msb>
											<access>read-write</access>
										</field>
									</fields>
								</register>

								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>23</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN24</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>24</lsb>
								<msb>24</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN25</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>25</lsb>
								<msb>25</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN26</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>26</lsb>
								<msb>26</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN27</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>27</lsb>
								<msb>27</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN28</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>28</lsb>
								<msb>28</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN29</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>29</lsb>
								<msb>29</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN30</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>30</lsb>
								<msb>30</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>EN31</name>
								<description>Access Enable for Master TAG ID q   ENq. This bit enables write access to the module kernel addresses for        transactions with the Master TAG ID q</description>
								<lsb>31</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
				</cluster>
				<cluster>
					<dim>128</dim>
					<dimIncrement>32</dimIncrement>
					<name>CH[%s]</name>
					<description>CH</description>
					<addressOffset>8192</addressOffset>
					<register>
						<name>RDCRCRc</name>
						<description>DMARAM Channel 000 Read Data CRC Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>0</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>RDCRC</name>
								<description>Read Data CRC   RDCRC. Checksum calculated for DMA read move data.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>SDCRCRc</name>
						<description>DMARAM Channel 000 Source and Destination Address CRC Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>4</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>SDCRC</name>
								<description>Source and Destination Address CRC   SDCRC. Checksum calculated for DMA move source and destination addresses.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>SADRc</name>
						<description>DMARAM Channel 000 Source Address Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>8</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>SADR</name>
								<description>Source Address   SADR. 32 bit source address.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>DADRc</name>
						<description>DMARAM Channel 000 Destination Address Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>12</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>DADR</name>
								<description>Destination Address   DADR. 32 bit destination address.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>ADICRc</name>
						<description>DMARAM Channel 000 Address and Interrupt Control Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>16</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>SMF</name>
								<description>Source Address Modification Factor   SMF. DMA channel TCS 32 bit source address modification factor and the        channel data width CHDW determines an address offset value by which the        source address is modified after each DMA move. If SCBE   1 B and CBLS  160    160 0000 B then the        source address is not modified.</description>
								<lsb>0</lsb>
								<msb>2</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>INCS</name>
								<description>Increment of Source Address   INCS. DMA channel TCS control bit to determine if the address offset selected        by SMF will be added to or subtracted from the source address after each        DMA move. If SCBE   1 B and CBLS  160    160 0000 B then the source address is not modified.</description>
								<lsb>3</lsb>
								<msb>3</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>DMF</name>
								<description>Destination Address Modification Factor   DMF. DMA channel TCS 32 bit destination address modification factor and the        channel data width CHDW determines an address offset value by which the        destination address is modified after each DMA move. If DCBE   1 B and CBLD  160    160 0000 B then the        destination address is not modified.</description>
								<lsb>4</lsb>
								<msb>6</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>INCD</name>
								<description>Increment of Destination Address   INCD. DMA channel TCS control bit to determine if the address offset selected        by DMF will be added to or subtracted from the destination address after        each DMA move. If DCBE   1 B and CBLD  160    160 0000 B the destination address is not modified.</description>
								<lsb>7</lsb>
								<msb>7</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CBLS</name>
								<description>Circular Buffer Length Source   CBLS. DMA channel TCS circular buffer source address update control bit        determines which part of the 32 bit source address register remains        unchanged and is not updated after a DMA move operation. CBLS determines the size of the circular source buffer.</description>
								<lsb>8</lsb>
								<msb>11</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CBLD</name>
								<description>Circular Buffer Length Destination   CBLD. DMA channel TCS circular buffer destination address update control bit        determines which part of the 32 bit destination address register remains        unchanged and is not updated after a DMA move operation. CBLD determines the size of the circular destination buffer.</description>
								<lsb>12</lsb>
								<msb>15</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>SHCT</name>
								<description>Shadow Control   SHCT. DMA channel TCS shadow control determines the function of the shadow        address register.</description>
								<lsb>16</lsb>
								<msb>19</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>SCBE</name>
								<description>Source Circular Buffer Enable   SCBE. DMA channel TCS source circular buffer enable.</description>
								<lsb>20</lsb>
								<msb>20</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>DCBE</name>
								<description>Destination Circular Buffer Enable   DCBE. DMA channel TCS destination circular buffer enable.</description>
								<lsb>21</lsb>
								<msb>21</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>STAMP</name>
								<description>Time Stamp   STAMP. DMA channel TCS control bit to enable the appendage of a timestamp after        the end of the last DMA Move during a DMA transaction.</description>
								<lsb>22</lsb>
								<msb>22</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>WRPSE</name>
								<description>Wrap Source Enable   WRPSE. DMA channel TCS source buffer interrupt trigger enable disable.</description>
								<lsb>24</lsb>
								<msb>24</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>WRPDE</name>
								<description>Wrap Destination Enable   WRPDE. DMA channel TCS destination buffer interrupt trigger enable disable.</description>
								<lsb>25</lsb>
								<msb>25</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>INTCT</name>
								<description>Interrupt Control   INTCT. DMA channel TCS interrupt control. If DMA channel CHCFGR.PRSEL   1 B for          the next lower priority channel then the channel transfer trigger          interrupt is disabled.</description>
								<lsb>26</lsb>
								<msb>27</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>IRDV</name>
								<description>Interrupt Raise Detect Value   IRDV. DMA channel TCS interrupt threshold value defines the Threshold Limit of        CHSR.TCOUNT for which a channel interrupt trigger will be raised.</description>
								<lsb>28</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CHCFGRc</name>
						<description>DMARAM Channel 000 Configuration Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>20</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>TREL</name>
								<description>Transfer Reload Value   TREL. DMA channel TCS transfer reload value to control the number of DMA        transfers in a DMA transaction. The 14 bit transfer count value is        loaded into ME CHSR.TCOUNT at the start of a DMA transaction  when        TSR.CH becomes set and CHSR.TCOUNT  160    160 0 . A write to CHCFGR.TREL during a        running DMA transaction has no influence on the running DMA transaction. If CHCFGR.TREL  160    160 0 or if CHCFGR.TREL  160    160 1 then ME CHSR.TCOUNT will be        loaded with 1 when a new DMA transaction is started  at least one DMA        transfer must be executed per DMA transaction .</description>
								<lsb>0</lsb>
								<msb>13</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>BLKM</name>
								<description>Block Mode   BLKM. Defines the number of DMA moves executed during one DMA transfer.</description>
								<lsb>16</lsb>
								<msb>18</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>RROAT</name>
								<description>Reset Request Only After Transaction   RROAT. DMA channel control bit to determine if the DMA request state flag  DMA        channel TSR.CH  is reset after each DMA transfer.</description>
								<lsb>19</lsb>
								<msb>19</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CHMODE</name>
								<description>Channel Operation Mode   CHMODE. DMA channel TCS control to determine TSR.HTRE reset condition.</description>
								<lsb>20</lsb>
								<msb>20</msb>
								<access>read-write</access>
								<enumeratedValues>
									<enumeratedValue>
										<name>Single_Mode0</name>
										<description>0 Single Mode is        selected for DMA channel. After a DMA transaction  DMA channel is        disabled for further hardware requests  TSR.HTRE is reset by hardware         TSR.HTRE must be set again by software for starting a new transaction.</description>
										<value>0</value>
									</enumeratedValue>
									<enumeratedValue>
										<name>Continuous_Mode1</name>
										<description>1 Continuous Mode is        selected for DMA channel. After a DMA transaction  bit TSR.HTRE remains        set.</description>
										<value>1</value>
									</enumeratedValue>
								</enumeratedValues>
							</field>
							<field>
								<name>CHDW</name>
								<description>Channel Data Width   CHDW. DMA channel TCS data width for DMA read moves and DMA write moves.</description>
								<lsb>21</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>PATSEL</name>
								<description>Pattern Select   PATSEL. DMA channel TCS bit field to select the pattern detection operation  see        Functional Description . If PATSEL 1 0  is not equal to 00 B then a ME pattern detection operation defined by the channel data width         CHDW  will be performed. PATSEL 2  selects the pattern read register.        If a pattern match is detected then a DMA channel interrupt shall be        triggered.</description>
								<lsb>24</lsb>
								<msb>26</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>SWAP</name>
								<description>Swap Data CRC Byte Order   SWAP. DMA channel TCS swap data CRC byte order.</description>
								<lsb>27</lsb>
								<msb>27</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>PRSEL</name>
								<description>Peripheral Request Select   PRSEL. DMA channel TCS control bit field to select the source of a DMA request.</description>
								<lsb>28</lsb>
								<msb>28</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>SHADRc</name>
						<description>DMARAM Channel 000 Shadow Address Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>24</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>SHADR</name>
								<description>Shadowed Address   SHADR. 32 bit shadow address.</description>
								<lsb>0</lsb>
								<msb>31</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CHCSRc</name>
						<description>DMARAM Channel 000 Control and Status Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>28</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>TCOUNT</name>
								<description>Transfer Count   TCOUNT. DMA channel status transfer count updated after DMARAM write back.</description>
								<lsb>0</lsb>
								<msb>13</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>LXO</name>
								<description>Old Value of Pattern Detection   LXO. DMA channel status bit to store the result of a pattern detection        operation when 8 bit or 16 bit data width is selected.</description>
								<lsb>15</lsb>
								<msb>15</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>WRPS</name>
								<description>Wrap Source Buffer   WRPS. Status bit indicates that a DMA channel has reached a wrap source buffer        boundary. Bit is reset by software  DMA channel CHCSR.CWRP   1 B or DMA channel reset TSR.RST   1 B  .</description>
								<lsb>16</lsb>
								<msb>16</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>WRPD</name>
								<description>Wrap Destination Buffer   WRPD. Status bit indicates that a DMA channel has reached a wrap destination        buffer boundary. Bit is reset by software  DMA channel CHCSR.CWRP   1 B or DMA channel reset TSR.RST   1 B  .</description>
								<lsb>17</lsb>
								<msb>17</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>ICH</name>
								<description>Interrupt from Channel   ICH. As soon as ME CHSR.TCOUNT decrements  if ADICR.INTCT 0    0 and        CHSR.COUNT   IRDV then ME CHSR.ICH is set else ME CHSR.ICH is set for        each decrement of CSR.TCOUNT. Bit is reset by software  DMA channel        CHCSR.CICH   1 B or by a DMA channel reset TSR.RST   1 B  .</description>
								<lsb>18</lsb>
								<msb>18</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>IPM</name>
								<description>Pattern Detection from Channel   IPM. Status bit indicates that a pattern match has been detected for the DMA        channel when pattern detection is enabled. This bit is reset by software         DMA channel CHCSR.CICH   1 B or DMA channel reset TSR.RST   1 B  .</description>
								<lsb>19</lsb>
								<msb>19</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>BUFFER</name>
								<description>DMA Double Buffering Active Buffer   BUFFER. During a DMA double buffering operation  the status bit indicates which        buffer is read or filled.</description>
								<lsb>22</lsb>
								<msb>22</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>FROZEN</name>
								<description>DMA Double Buffering Frozen Buffer   FROZEN. If a DMA channel is configured for double buffering operation  the        FROZEN bit indicates that one of the buffers is frozen and available for        processing by a cyclic software task. FROZEN bit shall only be set by the DMA and shall only be cleared by          software.</description>
								<lsb>23</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>SWB</name>
								<description>DMA Double Buffering Switch Buffer   SWB. When DMA double buffering is configured  the control bit is used to        re direct data from one buffer to the other buffer. If a DMALL  ACCLL  SAFLL or CONLL operation is configured then SWB          shall be 0 B .</description>
								<lsb>24</lsb>
								<msb>24</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>CWRP</name>
								<description>Clear Wrap Buffer Interrupt   CWRP. Software clear of the DMA channel source and destination wrap buffer        flags stored at CHCSR.WRPS and CHCSR.WRPD. If the DMA channel is active        in a ME then clear ME bit fields CHSR.WRPS and CHSR.WRPD. Reading this        bit returns a 0.</description>
								<lsb>25</lsb>
								<msb>25</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>CICH</name>
								<description>Clear Interrupt for DMA Channel   CICH. Software clear of the DMA channel flags stored at CHCSR.ICH and        CHCSR.IPM. If the DMA channel is active in a ME then clear ME bit fields        CHSR.ICH and CHSR.IPM. Reading this bit returns a 0.</description>
								<lsb>26</lsb>
								<msb>26</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>SIT</name>
								<description>Set Interrupt Trigger for DMA Channel   SIT. Reading this bit returns a 0. If a DMALL  ACCLL  SAFLL or CONLL operation is configured then SIT          must be 0 B .</description>
								<lsb>27</lsb>
								<msb>27</msb>
								<access>write-only</access>
							</field>
							<field>
								<name>SCH</name>
								<description>Set Transaction Request   SCH. Reading this bit returns a 0.</description>
								<lsb>31</lsb>
								<msb>31</msb>
								<access>write-only</access>
							</field>
						</fields>
					</register>
				</cluster>
				<register>
					<name>CLC</name>
					<description>DMA Clock Control Register
 resetvalue={Application Reset:0x08}</description>
					<addressOffset>0</addressOffset>
					<size>32</size>
					<resetValue>8</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DISR</name>
							<description>Module Disable Request Bit   DISR. Used for enable disable control of the DMA</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DISS</name>
							<description>Module Disable Status Bit   DISS. Bit indicates the current status of the DMA</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>EDIS</name>
							<description>Sleep Mode Enable Control   EDIS. Used for DMA sleep mode control.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ID</name>
					<description>DMA Identification Register
 resetvalue={Application Reset:0x087C000}</description>
					<addressOffset>8</addressOffset>
					<size>32</size>
					<resetValue>8896512</resetValue>
					<resetMask>4294967040</resetMask>
					<fields>
						<field>
							<name>MOD_REV</name>
							<description>Module Revision Number   MOD REV. This bit field defines the module revision number. See DMA Design Specification for MOD REV value.</description>
							<lsb>0</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MOD_TYPE</name>
							<description>Module Type   MOD TYPE. The bit field is set to C0 H which        defines the module as a 32 bit module.</description>
							<lsb>8</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MOD_NUMBER</name>
							<description>Module Number Value   MOD NUMBER. This bit field defines a module identification number.</description>
							<lsb>16</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>EER0</name>
					<description>ME 1 Enable Error Register
 resetvalue={Application Reset:0x4030000}</description>
					<addressOffset>288</addressOffset>
					<size>32</size>
					<resetValue>67305472</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>ESER</name>
							<description>Enable ME Source Error   ESER. This bit enables the generation of a ME source error interrupt.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>EDER</name>
							<description>Enable ME Destination Error   EDER. This bit enables the generation of a ME destination error interrupt.</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ELER</name>
							<description>Enable ME DMA Linked List Error   ELER. This bit enables the generation of a ME DMA Linked List error interrupt.</description>
							<lsb>26</lsb>
							<msb>26</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ERRSR0</name>
					<description>ME 1 Error Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>292</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>LEC</name>
							<description>ME Last Error Channel   LEC. This bit field indicates the DMA channel number of the last DMA channel        of ME generating an error i.e. RAM error DMA ERRSRm.RAMER  Safe Linked        List error DMA ERRSRm.SLLER  DMA Linked List error DMA ERRSRm.DLLER and        all on  160 chip  160 bus errors.</description>
							<lsb>0</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SER</name>
							<description>ME Source Error   SER. This bit is set whenever a ME error occurred during a source  read  move        of a DMA transfer  or a request could not been serviced due to the        access protection.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>DER</name>
							<description>ME Destination Error   DER. This bit is set whenever a ME error occurred during a destination         write  move of a DMA transfer  or a request could not been serviced due        to the access protection.</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SPBER</name>
							<description>ME SPB Bus Error   SPBER. This bit is set when a ME DMA Move that has been started by the DMA SPB        master interface leads to an error on the SPB  160 Bus.</description>
							<lsb>20</lsb>
							<msb>20</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SRIER</name>
							<description>ME SRI Bus Error   SRIER. This bit is set when a ME DMA Move that has been started by the DMA SRI        master interface leads to an error on the SRI  160 Bus.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>RAMER</name>
							<description>ME RAM Error   RAMER. This bit is set whenever a ME error occurred during the loading of a TCS        from the DMARAM to the ME channel registers.</description>
							<lsb>24</lsb>
							<msb>24</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SLLER</name>
							<description>ME Safe Linked List Error   SLLER. This bit is set when a ME error occurred during the comparison of a        SDCRC checksums during a safe linked list.</description>
							<lsb>25</lsb>
							<msb>25</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>DLLER</name>
							<description>ME DMA Linked List Error   DLLER. This bit is set when a ME error occurred during a DMALL  ACCLL  SAFLL or        CONLL operation when a new TCS is loaded from anywhere in memory to        overwrite the current TCS stored in the DMARAM.</description>
							<lsb>26</lsb>
							<msb>26</msb>
							<access>read-only</access>
						</field>
					</fields>

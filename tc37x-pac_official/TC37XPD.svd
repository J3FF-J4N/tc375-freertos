					<fields>
						<field>
							<name>TMUX0</name>
							<description>Trace Source Select 0   TMUX0. This bit field determines which trace source is seen by POBx. This bit field can only be changed  if TM0 P is written   x2018 1  x2019   xa0 simultaneously. Not all sources are available in all products of the family. Please refer to Platform Feature Overview table of the TC3xx documentation.</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TM0_P</name>
							<description>Trace Source Select 3 Protection   TM3 P. This bit determines whether TMUXz is changed by a write to the MUX register. TM1 P  TM2 P  TM3 P are not relevant for miniMCDS.</description>
							<lsb>7</lsb>

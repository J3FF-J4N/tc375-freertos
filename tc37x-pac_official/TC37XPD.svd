							<lsb>12</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RXFC</name>
							<description>RX FIFO Flow Control   RXFC</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TXFC</name>
							<description>TX FIFO Flow Control   TXFC</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CRBC</name>
							<description>Clear Request Behavior Configuration   CRBC. Used to configure the clear request behavior for the FIFO data request.        Can only be used for single request and must be set to   8220 0  8221  when burst        accesses are used in the system  eg. when TX RXBS  gt  0 </description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MRPSCTRL</name>
					<description>Maximum Received Packet Size Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>44</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MRPS</name>
							<description>Maximum Received Packet Size   MRPS. Length in characters of packet to be received  write value range  0         unlimited size  to 16383 Reading returns the written value as long as the previous packet has not        been read completely from the FIFO. After that  MRPS is loaded to an        internal register  reading returns 0 and a new value can be written.</description>
							<lsb>0</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RPSSTAT</name>
					<description>Received Packet Size Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>48</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RPS</name>
							<description>Received Packet Size   RPS. Length in characters of the received packet  0 to 16383 </description>
							<lsb>0</lsb>
							<msb>13</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>TPSCTRL</name>
					<description>Transmit Packet Size Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>52</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>TPS</name>
							<description>Transmit Packet Size   TPS. Length in characters of the transmit packet  write value range  1 to        16383 Reading returns the written value as long as it is not loaded to an        internal counter. After that  reading returns 0 and a new value can be        written.</description>
							<lsb>0</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FFSSTAT</name>
					<description>Filled FIFO Stages Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>56</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>FFS</name>
							<description>Filled FIFO Stages   FFS. Number of filled FIFO stages  0 to 8 </description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
					</fields>

							<resetValue>4294967294</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>RANGE</name>
									<description>IP Comparator range size   RANGE. As TriCore instructions are sized in multiples of 16 bit the LSB is fixed to 0. For a functional description of the comparator see CROSSREFERENCE .</description>
									<lsb>1</lsb>
									<msb>31</msb>
									<access>read-write</access>
								</field>
							</fields>
						</register>
					</cluster>
				</cluster>
				<register>
					<name>CLC</name>
					<description>Clock Control Register
 resetvalue={PowerOn Reset:0x3}</description>
					<addressOffset>0</addressOffset>
					<size>32</size>
					<resetValue>3</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DISR</name>
							<description>Disable Request Bit   DISR. This bit is used to request a change of the clocking state. Turn off requests are ignored while the Flush flag is not asserted.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DISS</name>
							<description>Disable Status Bit   DISS. This bit field indicates the current clocking state.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>OCS</name>
					<description>OCDS Control and Status
 resetvalue={MCDS Reset:0x0}</description>
					<addressOffset>4</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>SUS</name>
							<description>OCDS Suspend Control   SUS. Controls the sensitivity to the suspend signal coming from the SCU before Power On Reset</description>
							<lsb>24</lsb>
							<msb>27</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SUS_P</name>
							<description>SUS Write Protection   SUS P. SUS is only written when SUS P is 1  otherwise unchanged. Read as 0.</description>
							<lsb>28</lsb>
							<msb>28</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SUSSTA</name>
							<description>Suspend State inverted busy o    SUSSTA</description>
							<lsb>29</lsb>
							<msb>29</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ID</name>
					<description>Module Identification Register
 resetvalue={PowerOn Reset:0x0D6C007,MCDS Reset:0x0,Debug Reset:0x0}</description>
					<addressOffset>8</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>0</resetMask>
					<fields>
						<field>
							<name>MOD_REV</name>
							<description>Module Revision   MOD REV. This bit field indicates the revision number of the module implementation.</description>
							<lsb>0</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MOD_TYPE</name>
							<description>Module Type   MOD TYPE</description>
							<lsb>8</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MOD_NUMBER</name>
							<description>Module Number   MOD NUMBER</description>
							<lsb>16</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CT</name>
					<description>MCDS Control Register
 resetvalue={PowerOn Reset:0x0A0,MCDS Reset:0x0,Debug Reset:0x0}</description>
					<addressOffset>16</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>0</resetMask>
					<fields>
						<field>
							<name>KOK</name>
							<description>Key OK Flag   KOK. This bit is always set for MINIMCDS .</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>KAV</name>
							<description>Key Available Flag   KAV. This bit is always set for MINIMCDS .</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>EN</name>
							<description>MCDS Enable Flag   EN. This bit field indicates whether the MCDS is write enabled.</description>
							<lsb>13</lsb>
							<msb>13</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CLRE</name>
							<description>Clear MCDS Enable Flag   CLRE. This bit allows to reset the MCDS enable Flag by software and thus to write protect the MCDS address range.</description>
							<lsb>14</lsb>
							<msb>14</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SETE</name>
							<description>Set MCDS Enable Flag   SETE. This control bit is the only way to set the MCDS enable flag.</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>BED</name>
							<description>Bus Error Disable Flag   BED. This bit field indicates whether writing to an SFR not implemented in        the MCDS address space is considered an error. In TC3xx the usage of this bit is obsolete for miniMCDS.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>BED_P</name>
							<description>Bus Error Disable Protection   BED P. This bit determines whether BED is changed by a write to the CT register.</description>
							<lsb>19</lsb>
							<msb>19</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>IRA</name>
							<description>Invalid Read Access Flag   IRA. This bit field indicates whether any read access to the MCDS address range failed. This is not a bus error  the MCDS module just returns all zeros in this case.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CLRI</name>
							<description>Clear Invalid Access Bits   CLRI. This control bit is the only way the clear the error bits.</description>
							<lsb>22</lsb>
							<msb>22</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>IWA</name>
							<description>Invalid Write Access Flag   IWA. This bit field indicates whether any write access to the MCDS address range failed. The MCDS module ignores the data of erroneous writes.</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>RES</name>
							<description>MCDS ResetFlag   RES. This bit reflects the current value of the MCDS Reset request. Granting of the request will automatically clear this bit.</description>
							<lsb>29</lsb>
							<msb>29</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SETR</name>
							<description>MCDS ResetRequest Bit   SETR. This bit can be used to cause a MCDS Reset   affecting debug resources like the MCDS registers as specified in the Reset behavior tables.</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>write-only</access>
						</field>
					</fields>

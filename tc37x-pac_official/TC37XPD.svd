						</field>
						<field>
							<name>ASEL4</name>
							<description>CDTM4 DTM4 AUX Input Selection  ATOMx CH0...3 . This bit field defines which GPIO DSADC EVADC signal is connected to the        CDTMx DTM4 AUX input.</description>
							<lsb>8</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TSEL0</name>
							<description>CDTM2 DTM0 AUX Input Selection  TOMx CH0...3 . This bit field defines which GPIO DSADC EVADC signal is connected to the        CDTMx DTM0 AUX input.</description>
							<lsb>16</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TSEL1</name>
							<description>CDTM2 DTM0 AUX Input Selection  TOMx CH0...3 . This bit field defines which GPIO DSADC EVADC signal is connected to the        CDTMx DTM0 AUX input.</description>
							<lsb>18</lsb>
							<msb>19</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TSEL2</name>
							<description>CDTM2 DTM0 AUX Input Selection  TOMx CH0...3 . This bit field defines which GPIO DSADC EVADC signal is connected to the        CDTMx DTM0 AUX input.</description>
							<lsb>20</lsb>
							<msb>21</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CANOUTSEL0</name>
					<description>CAN0 CAN1 Output Select Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>655324</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>SEL0</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL1</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>4</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL2</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>8</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL3</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>12</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL4</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>16</lsb>
							<msb>19</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL5</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>20</lsb>
							<msb>23</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL6</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>24</lsb>
							<msb>27</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL7</name>
							<description>Output Selection for GTM to CAN connection 7. This bit field defines which TOM ATOM channel output is used as        CAN0 CAN1 node trigger x. Triggers        0 and 1 are also sent to the TTCAN. The decoding is defined in the specific appendix.</description>
							<lsb>28</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>CANOUTSEL1</name>
					<description>CAN2 Output Select Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>655328</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>65535</resetMask>
					<fields>
						<field>
							<name>SEL0</name>
							<description>Output Selection for GTM to CAN connection 3. This bit field defines which TOM ATOM channel output is used as CAN2        node trigger x. The        decoding is defined in the specific appendix.</description>
							<lsb>0</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL1</name>
							<description>Output Selection for GTM to CAN connection 3. This bit field defines which TOM ATOM channel output is used as CAN2        node trigger x. The        decoding is defined in the specific appendix.</description>
							<lsb>4</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL2</name>
							<description>Output Selection for GTM to CAN connection 3. This bit field defines which TOM ATOM channel output is used as CAN2        node trigger x. The        decoding is defined in the specific appendix.</description>
							<lsb>8</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SEL3</name>
							<description>Output Selection for GTM to CAN connection 3. This bit field defines which TOM ATOM channel output is used as CAN2        node trigger x. The        decoding is defined in the specific appendix.</description>
							<lsb>12</lsb>

					<cluster>
						<name>NT</name>
						<description>NT</description>
						<addressOffset>32</addressOffset>
						<register>
							<name>NTCCRi</name>
							<description>Node 0 Timer Clock Control Register
 resetvalue={Application Reset:0x0}</description>
							<addressOffset>0</addressOffset>
							<size>32</size>
							<resetValue>0</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>TPSC</name>
									<description>Timer Prescaler   TPSC. The duration of one timer clock is given by  TPSC  160    160 1  CAN bit times for        all NTCCRi.TRIGSRC settings.</description>
									<lsb>8</lsb>
									<msb>11</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>STRESET</name>
									<description>Stamping Reset   STRESET. This bit is not implemented in TC39x A step silicon. This bit gives the possibility to reset the time stamp for CAN FD messages.</description>
									<lsb>14</lsb>
									<msb>14</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>STSTART</name>
									<description>Stamping Start   STSTART. This bit is not implemented in TC39x A step silicon. This bit starts the external timer used for CAN FD messages. The source and the prescaler are identical to the timers A B C.</description>
									<lsb>15</lsb>
									<msb>15</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TRIGSRC</name>
									<description>Trigger Source   TRIGSRC. This bit selects the trigger source for the different modes in the node        timer.</description>
									<lsb>18</lsb>
									<msb>20</msb>
									<access>read-write</access>
								</field>
							</fields>
						</register>
						<register>
							<name>NTATTRi</name>
							<description>Node 0 Timer A Transmit Trigger Register
 resetvalue={Application Reset:0x10000}</description>
							<addressOffset>4</addressOffset>
							<size>32</size>
							<resetValue>65536</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>RELOAD</name>
									<description>Reload Value   RELOAD. This bit field contains the reload value for the timer. The timer will        restart when RELOAD is written.</description>
									<lsb>0</lsb>
									<msb>15</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TXMO</name>
									<description>Transmit Message Object   TXMO. This transmit trigger is fixed to transmit buffer 1</description>
									<lsb>16</lsb>
									<msb>23</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>STRT</name>
									<description>Timer Start   STRT. This bit field controls the operation of the timer.</description>
									<lsb>24</lsb>
									<msb>24</msb>
									<access>read-write</access>
								</field>
							</fields>

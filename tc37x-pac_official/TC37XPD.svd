					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>CLKSEL0</name>
							<description>Clock Select 0   CLKSEL0. This bitfield is MCR.CI and MCR.CCCE protected.</description>
							<lsb>0</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CLKSEL1</name>
							<description>Clock Select 1   CLKSEL1. This bitfield is MCR.CI and MCR.CCCE protected.</description>
							<lsb>2</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CLKSEL2</name>
							<description>Clock Select 2   CLKSEL2. This bitfield is MCR.CI and MCR.CCCE protected.</description>
							<lsb>4</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CLKSEL3</name>
							<description>Clock Select 3   CLKSEL3. This bitfield is MCR.CI and MCR.CCCE protected.</description>
							<lsb>6</lsb>
							<msb>7</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>NODE</name>
							<description>Node   NODE. This bit field determines the CAN node i which is used for debug over        CAN. This bitfield only exists on CAN0.</description>
							<lsb>24</lsb>
							<msb>26</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DXCM</name>
							<description>Debug Over CAN Messages Enable   DXCM. This bit enables the debug over serial connections between DAP and CAN0        module. If enabled the lowest receive transmit message buffer is reserved for        debugger communication. DXCM is described in detail in the OCDS chapter.        This bit only exists on CAN0.</description>
							<lsb>27</lsb>
							<msb>27</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RBUSY</name>
							<description>RAM BUSY   RBUSY. This bit is not implemented in TC39x A step silicon. This bit shows that the RAM Initialization is running. This bit is set back to 0b by hardware when the RAM intialization is completed.</description>
							<lsb>28</lsb>
							<msb>28</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>RINIT</name>
							<description>RAM Init   RINIT. This bit is not implemented in TC39x A step silicon. This bit is MCR.CI and MCR.CCCE protected. This bit starts the initialization of the RAM block to all 0x0. The RAM initialization is started only when this bit is changed from 0b to 1b and also RBUSY is 0b.</description>
							<lsb>29</lsb>
							<msb>29</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CI</name>
							<description>Change Init   CI. Needs to be set to enable and disable clocks.</description>
							<lsb>30</lsb>
							<msb>30</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CCCE</name>
							<description>Clock and RAM Change Enable   CCCE. Needs to be set to enable and disable the clocks.</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>

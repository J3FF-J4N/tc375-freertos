									<msb>4</msb>
									<access>read-write</access>
								</field>
								<field>
									<name>TISI</name>
									<description>TRIGGER inactive slope interrupt. The TISI bit is only set for an inactive slope when the preceding active        slope was accepted. In the case of suppression of the last active slope        by the plausibility check the next inactive slope is to be ignored. No        set of TISI is performed in this case.</description>
									<lsb>5</lsb>
									<msb>5</msb>
									<access>read-write</access>
								</field>

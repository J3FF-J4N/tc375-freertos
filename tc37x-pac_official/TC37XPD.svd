					<fields>
						<field>
							<name>EXPFIX</name>
							<description>Exponent for Fixed Exponent Format   EXPFIX. This field stores the exponent to be used when V is stored in memory as a 16 bit  fixed point value. See the related VFRMT field.</description>
							<lsb>0</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>VFRMT</name>
							<description>Parameter Matrix V Format   VFRMT. This field controls the storage format of parameter matrix V. It can have the following values </description>
							<lsb>16</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CFGSET</name>
							<description>Configuration Set   CFGSET. When set to 1   z is initialised to p 5 . When set to 0   z is not initialised and returns whatever value is present in the register from previous operations.</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>EER</name>
					<description>Error Enable Register
 resetvalue={Application Reset:0x40007F}</description>
					<addressOffset>4</addressOffset>
					<size>32</size>
					<resetValue>4194431</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>P7MAX</name>
							<description>Enable Interrupt on P7 Over Maximum Error   P7MAX. Enable interrupt on P7MAX error.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>IINF</name>
							<description>Enable Interrupt on Input Infinity Error   IINF. Enable interrupt if input value is infinity</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INAN</name>
							<description>Enable Interrupt on Input NaN Error   INAN. Enable interrupt if input value is not a number  NaN </description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>OOV</name>
							<description>Enable Interrupt on Output Overflow   OOV. Enable interrupt if output overflows.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ME</name>
							<description>Enable Interrupt on Memory Error   ME. Enable interrupt on memory error</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>REGACC</name>
							<description>Enable Interrupt on Register Access during Computation Error   REGACC. This flag enables interrupt generation if registers are written during computation</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DENORM</name>
							<description>Enable Interrupt on Input Denormalised Number Error   DENORM. Enable interrupt if a 32 bit input value contains a denormalised number</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ECC_STOP</name>
							<description>Stop on ECC Error   ECC STOP. Enable the use of an ECC error detected during a read from a system        memory to stop the AMU and flag an interrupt</description>
							<lsb>15</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>DENEN</name>
							<description>Enable Stop on Input Denormalised Number Error.   DENEN. Stop execution if a 32 bit input value contains a denormalised number</description>
							<lsb>22</lsb>
							<msb>22</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>EECN</name>
							<description>Enable Stop Condition Bit   EECN. Must be written with 1 to allow the        state of bit 22 to be changed</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>P10SINT</name>
					<description>Parameter p10 Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>8</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>NCROSSING</name>
							<description>Loop Counter Value to Raise Limit Interrupt   NCROSSING. AMU will raise the limit interrupt if p8 is equal to or greater than this value.</description>
							<lsb>0</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>

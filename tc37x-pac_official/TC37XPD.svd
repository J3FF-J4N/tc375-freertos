									<msb>15</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>GT</name>
									<description>Global Time   GT. Non fractional part of the sum of the node  8217 s local time and its local        offset. Global time value of TTCAN network</description>
									<lsb>16</lsb>
									<msb>31</msb>
									<access>read-only</access>
								</field>
							</fields>

				<register>
					<dim>4</dim>
					<dimIncrement>4</dimIncrement>
					<name>UDx[%s]</name>
					<description>Upstream Data Register 0
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>48</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DATA</name>
							<description>Received Data   DATA. This bit field contains the 8 bit receive data.</description>
							<lsb>0</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>V</name>
							<description>Valid Bit   V. This bit is set by hardware when the received data is written to UDx. Writing bit C   1 clears V. If hardware setting and software clearing of the valid bit occur simultaneously  bit V will be cleared.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>P</name>
							<description>Parity Bit   P. This flag contains the parity bit that has been received with the data frame.</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>C</name>
							<description>Clear Bit   C. C is always read as 0.</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>LABF</name>
							<description>Lower Address Bit Field   LABF. This bit field contains the two address bits A 1 0  of the 4 bit address field  16 bit data frame . If 12 bit data frame is selected  LABF is always set to 00 B .</description>
							<lsb>19</lsb>
							<msb>20</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>IPF</name>
							<description>Internal Parity Flag   IPF. This bit contains the parity bit that has been calculated in the MSC during data frame reception.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>PERR</name>
							<description>Parity Error   PERR. This bit indicates if a start bit error  parity error  or stop bit error occurred during frame reception.</description>
							<lsb>22</lsb>
							<msb>22</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>

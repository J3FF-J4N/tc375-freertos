								<name>IDLE</name>
								<description>Run Flag   IDLE</description>
								<lsb>1</lsb>
								<msb>1</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>HALT</name>
								<description>Halted Flag   HALT. This is basically the DBGSR.HALT bit.</description>
								<lsb>2</lsb>
								<msb>2</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>ISR</name>
								<description>Interrupt Service Flag   ISR. This bit indicated whether regular code or a trap interrupt handler is executed.</description>
								<lsb>3</lsb>
								<msb>3</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>HBRK</name>
								<description>Hardware Break Flag   HBRK. This bit reflects the reaction to a break request from a OTGS trigger line  filtered by the EXEVT register.</description>
								<lsb>4</lsb>
								<msb>4</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>SBRK</name>
								<description>Software Break Flag   SBRK. This bit reflects the reaction to a DEBUG instruction  filtered by the SWEVT register.</description>
								<lsb>5</lsb>
								<msb>5</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>IEN</name>
								<description>Interrupt Enable Flag   IEN</description>
								<lsb>7</lsb>
								<msb>7</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>DBGEN</name>
								<description>Debug Enabled Flag   DBGEN</description>
								<lsb>8</lsb>
								<msb>8</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CLKDIV</name>
								<description>Current Clock Divider   CLKDIV. The SCU provides the clock for the TriCore as well as for MCDS. The current ration is reported here.</description>
								<lsb>9</lsb>
								<msb>10</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>NESTED_ISR</name>
								<description>Nested Interrupt Level   NESTED ISR. The nested interrupt level is exactly indicated for nesting levels 0          15. For nesting levels greater 15 the value shown is 0xF.</description>
								<lsb>11</lsb>
								<msb>14</msb>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<register>
						<name>TCXCIP</name>
						<description>Current Instruction Pointer
 resetvalue={PowerOn Reset:0x0}</description>
						<addressOffset>8</addressOffset>

					<dim>8</dim>
					<dimIncrement>4</dimIncrement>
					<name>DATAENTRYx[%s]</name>
					<description>DATA ENTRY Register 0
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>100</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>E</name>
							<description>Entry Point to the TxFIFO   E</description>

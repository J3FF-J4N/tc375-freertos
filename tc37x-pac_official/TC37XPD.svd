							</field>
						</fields>
					</register>
					<register>
						<name>CH0_CM0</name>
						<description>TOM0 Channel 15 CCU0 Compare Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>12</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CM0</name>
								<description>TOM CCU0 compare register. Setting CM0  lt  CM1 configures a duty cycle of 100 .</description>
								<lsb>0</lsb>
								<msb>15</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH0_CM1</name>
						<description>TOM0 Channel 15 CCU1 Compare Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>16</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CM1</name>
								<description>TOM CCU1 compare register. Setting CM1   0 configures a duty cycle of 0   independent of the        configured value of CM0.</description>
								<lsb>0</lsb>
								<msb>15</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH0_CN0</name>
						<description>TOM0 Channel 15 CCU0 Counter Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>20</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CN0</name>
								<description>TOM CCU0 counter register. This counter is stopped if the TOM channel is disabled and not reset on        an enable event of TOM channel.</description>
								<lsb>0</lsb>
								<msb>15</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH0_STAT</name>
						<description>TOM0 Channel 15 Status Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>24</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>OL</name>
								<description>Output level of output TOM OUT x . Reset value is the inverted value of SL bit  which depends on the        hardware configuration chosen by silicon vendor.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-only</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH0_IRQ_NOTIFY</name>
						<description>TOM0 Channel 15 Interrupt Notification Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>28</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CCU0TC</name>
								<description>CCU0 Trigger condition interrupt for channel x. The notification of the interrupt is only triggered one time after        reaching the condition CN0  gt   CM0. To enable re trigger of the        notification  first the condition CN0  lt  CM1 has to be reached. Note  This bit will be cleared on a CPU write access of value 1. A        read access leaves the bit unchanged. Note  This        description differs to the description in the Bosch spec.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>CCU1TC</name>
								<description>CCU1 Trigger condition interrupt for channel x. The notification of the interrupt is only triggered one time after        reaching the condition CN0  gt   CM1. To enable re trigger of the        notification  first the condition CN0  lt  CM1 has to be reached. Note  This bit will be cleared on a CPU write access of value 1. A        read access leaves the bit unchanged. Note  This        description differs to the description in the Bosch spec.</description>
								<lsb>1</lsb>
								<msb>1</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH0_IRQ_EN</name>
						<description>TOM0 Channel 15 Interrupt Enable Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>32</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>

							<name>DP</name>
							<description>Data Pointer   DP. Pointer to the first 32 bit word of the Data Section of the addressed Message Buffer in the Message RAM.</description>
							<lsb>0</lsb>
							<msb>10</msb>
							<access>read-only</access>

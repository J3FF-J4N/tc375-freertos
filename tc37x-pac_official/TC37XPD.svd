							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TS</name>
							<description>Initial State Trap   TS. of PSW.S bit in trap handle</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>ESDIS</name>
							<description>Emulator Space Disable. Disable the Emulator Space system</description>
							<lsb>8</lsb>

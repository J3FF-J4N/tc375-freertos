							<field>
								<name>NTI_CNT</name>
								<description>Number of TRIGGERs to interrupt. Number of active TRIGGER events to the next DPLL CDTI interrupt. This value shows the remaining TRIGGER events until an active TRIGGER slope results in a DPLL CDTI interrupt         the value is to be count down for each active TRIGGER event.</description>
								<lsb>0</lsb>
								<msb>9</msb>
								<access>read-write</access>
							</field>
						</fields>

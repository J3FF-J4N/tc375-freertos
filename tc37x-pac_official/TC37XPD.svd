							<name>RXTCPERROCT</name>
							<description>RxTCP Error Octets   RXTCPERROCT. This field indicates the number of bytes received in a TCP segment that had checksum errors. This counter does not count IP header bytes. Value After Reset  0x0</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RXICMP_GOOD_OCTETS</name>
					<description>Good Received ICMP Octets Count Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>2176</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RXICMPGDOCT</name>
							<description>RxICMP Good Octets   RXICMPGDOCT. This field indicates the number of bytes received in a good ICMP segment. This counter does not count IP header bytes. Value After Reset  0x0</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>

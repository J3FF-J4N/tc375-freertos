					<resetValue>127</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>AM</name>
							<description>Address Match   AM</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>GC</name>
							<description>General Call   GC</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MC</name>
							<description>Master Code   MC</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>AL</name>
							<description>Arbitration Lost   AL</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>NACK</name>
							<description>Not acknowledge Received   NACK</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TX_END</name>
							<description>Transmission End   TX END</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RX</name>
							<description>Receive Mode   RX</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>PIRQSS</name>
					<description>Protocol Interrupt Request Source Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>116</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>AM</name>
							<description>Address Match   AM. Device  in master or slave mode  is addressed by remote master  matching        device address . Accordingly  bit field BS in register BUSSTAT is set to 11 .</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>GC</name>
							<description>General Call   GC. Remote master has transmitted a general call.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MC</name>
							<description>Master Code   MC. Remote master has transmitted a master call.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AL</name>
							<description>Arbitration Lost   AL. Device  master mode  lost the control on the I2C bus due to losing        arbitration procedure. Accordingly  bit field BS in register BUSSTAT is set to 01 .</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>NACK</name>
							<description>Not acknowledge Received   NACK. When working as transmitter this interrupt indicates a not acknowledge        from the remote receiver. The SW has to decide what further steps have        to be taken.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-only</access>
						</field>

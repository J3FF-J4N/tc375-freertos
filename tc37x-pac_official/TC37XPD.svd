						<field>
							<name>FEN0</name>
							<description>Falling Edge Enable 0   FEN0. This bit determines if the falling edge of Input Channel  2i  is used to set bit INTF 2i .</description>
							<lsb>8</lsb>
							<msb>8</msb>
							<access>read-write</access>

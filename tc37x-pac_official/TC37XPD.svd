								<lsb>16</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH7_TDUV</name>
						<description>TIM0 Channel 7 TDU Control Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>920</addressOffset>

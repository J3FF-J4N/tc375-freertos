								<lsb>8</lsb>
								<msb>8</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>BUFF_OVL</name>
								<description>Buffer overflow register. A buffer overflow can occur while multiple aborts are issued by the        external bus or a pipelined instruction is started while FBC   0  see        GTM BRIDGE PTR1 register .</description>

					<resetValue>3</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DISR</name>
							<description>Module Disable Request Bit   DISR. Used for enable disable control of the module.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>DISS</name>
							<description>Module Disable Status Bit   DISS. Bit indicates the current status of the module.</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SPEN</name>
							<description>Module Suspend Enable Bit for OCDS   SPEN</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>EDIS</name>
							<description>External Request Disable   EDIS. This bit is not used in TC39x and should always be written with 0.</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SBWE</name>
							<description>Module Suspend Bit Write Enable for OCDS   SBWE. This bit is always read as 0.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>FSOE</name>
							<description>Fast Switch Off Enable   FSOE</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RMC</name>
							<description>Clock Divider for Standard Run Mode   RMC. Max. 8 bit divider value If RMC is set to 0 the module is disabled. As long as the new divider value RMC is not valid  reading register          returns 0000 00XX H</description>
							<lsb>8</lsb>
							<msb>15</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ID</name>
					<description>Module Identification Register
 resetvalue={Application Reset:0x5705}</description>
					<addressOffset>8</addressOffset>
					<size>32</size>
					<resetValue>22277</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MOD_REV</name>
							<description>Module Revision Number   MOD REV. This bit field defines the revision number.</description>
							<lsb>0</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>MOD_NUMBER</name>
							<description>Module Number   MOD NUMBER. This bit field defines the module identification number.</description>
							<lsb>8</lsb>
							<msb>15</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RUNCTRL</name>
					<description>RUN Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>16</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RUN</name>
							<description>Enable I2C bus Interface   RUN</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ENDDCTRL</name>
					<description>End Data Control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>20</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>SETRSC</name>
							<description>Set Restart Condition   SETRSC. This bit is always read as 0.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>SETEND</name>
							<description>Set End of Transmission   SETEND. This bit is always read as 0. Do not write 1 to this bit when bus is free. This will cause an abort          after the first byte when a new transfer is started.  This            8217 command  8217  is buffered internally and gets valid after the next byte is          transferred. </description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FDIVCFG</name>
					<description>Fractional Divider Configuration Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>24</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DEC</name>
							<description>Decrement Value of Fractional Divider   DEC. For standard fast mode  see CROSSREFERENCE .</description>
							<lsb>0</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INC</name>
							<description>Increment Value of Fractional Divider   INC. For standard fast mode  see CROSSREFERENCE .</description>
							<lsb>16</lsb>
							<msb>23</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FDIVHIGHCFG</name>
					<description>Fractional Divider High speed Mode Configuration Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>28</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>DEC</name>
							<description>Decrement Value of Fractional Divider   DEC. For high speed mode  see CROSSREFERENCE .</description>
							<lsb>0</lsb>
							<msb>10</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>INC</name>
							<description>Increment Value of Fractional Divider   INC. For high speed mode  see CROSSREFERENCE .</description>
							<lsb>16</lsb>
							<msb>23</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>ADDRCFG</name>
					<description>Address Configuration Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>32</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>ADR</name>
							<description>I2C bus Device Address   ADR. This bit field determines the address of the device when addressed as a slave.  Watch out for reserved addresses by referring to I2C bus spec V2.1.  Depending on setting of TBAM  this is either a 7 bit address  bits  7 1   or a 10 bit address  bits  9 0  .</description>
							<lsb>0</lsb>
							<msb>9</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TBAM</name>
							<description>Ten Bit Address Mode   TBAM. When this bit is zero  only bits 7 down to 1 of the ADR field are          valid.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>GCE</name>
							<description>General Call Enable   GCE</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MCE</name>
							<description>Master Code Enable   MCE</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MnS</name>
							<description>Master   not Slave   MnS</description>
							<lsb>19</lsb>
							<msb>19</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SONA</name>
							<description>Stop on Not acknowledge   SONA. After successful transmission of a master code  during high speed          mode  SONA is not considered till a stop condition is manually          generated by SETEND.</description>
							<lsb>20</lsb>
							<msb>20</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>SOPE</name>
							<description>Stop on Packet End   SOPE. This bit field should be used only in Master Mode. In slave mode         should always be 0. If device works as receiver a not acknowledge is always generated         on package end. After successful transmission of a master code  during high speed         mode  SOPE is not considered till a stop condition is manually generated by SETEND.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>BUSSTAT</name>
					<description>Bus Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>36</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>BS</name>
							<description>Bus Status   BS. Shows the current status on the I2C bus.</description>
							<lsb>0</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>RnW</name>
							<description>Read not Write   RnW. Set by hardware automatically after address byte has been sent received.</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>

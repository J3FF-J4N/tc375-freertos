							<name>E</name>
							<description>Entry Point to the TxFIFO   E</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>BACONENTRY</name>
					<description>BACON ENTRY Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>96</addressOffset>

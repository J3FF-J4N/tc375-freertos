						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CM0</name>
								<description>ATOM CCU0 compare register</description>
								<lsb>0</lsb>
								<msb>23</msb>
								<access>read-write</access>
							</field>
						</fields>
					</register>
					<register>
						<name>CH1_CM1</name>
						<description>ATOM0 Channel 7 CCU1 Compare Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>148</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>CM1</name>
								<description>ATOM CCU1 compare register</description>
								<lsb>0</lsb>

 resetvalue={Application Reset:0x084F022E}</description>
						<addressOffset>476</addressOffset>
						<size>32</size>
						<resetValue>139395630</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>GRSTEN</name>
								<description>Global Reset Enable</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>BRIDGE_MODE_RST</name>

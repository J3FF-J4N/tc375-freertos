								<lsb>2</lsb>
								<msb>2</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CY</name>
								<description>Carry bit state. This bit is read only and it mirrors the internal carry flag CY.</description>
								<lsb>4</lsb>
								<msb>4</msb>

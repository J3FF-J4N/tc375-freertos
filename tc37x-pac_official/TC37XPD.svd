							<name>E</name>
							<description>Read Point from the RxFIFO   E</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>RXEXITD</name>
					<description>RX EXIT Debug Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>148</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>E</name>
							<description>Read Point from the RxFIFO   E</description>
							<lsb>0</lsb>
							<msb>31</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MC</name>
					<description>Move Counter Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>164</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>MCOUNT</name>
							<description>Move Count   MCOUNT. Defines the number of moves to be performed in short mode  in range of 1        to 8191.</description>
							<lsb>0</lsb>
							<msb>12</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>CURRENT</name>
							<description>Current Status of the Move Counter   CURRENT. Shows the current status of the Move Counter  that is  how many data blocks are to be transmitted until the end of the frame.</description>
							<lsb>16</lsb>
							<msb>28</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>MCCON</name>
					<description>Move Counter control Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>168</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>TPRE2</name>
							<description>Prescaler for the Trailing Delay 2   TPRE2. Trailing delay injected in the configuration register for the last data        if T2EN is set. Length in units T PER</description>
							<lsb>0</lsb>
							<msb>2</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TRAIL2</name>
							<description>Last Trailing Delay   TRAIL2. Trailing delay injected in the configuration register for the last data        if T2EN is set. Defines the length of the leading delay  in T PER units pre scaled with TPRE</description>
							<lsb>3</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>IBLEN</name>
							<description>Interrupt Before Last Enable   IBLEN. Enable bit for this event.</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>IBLF</name>
							<description>Interrupt Before Last Flag   IBLF. Flag bit for this event.</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>IBLC</name>
							<description>Clear Bit for IBLF   IBLC. Writing 1 clears the IBLF. Writing 0 has no effect. Returns 0 on read.</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>IBLS</name>
							<description>Set Bit for IBLF   IBLS. Writing 1 sets the IBLF and triggers an interrupt  if enabled . Writing        0 has no effect. Returns 0 on read.</description>
							<lsb>19</lsb>
							<msb>19</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>IALEN</name>
							<description>Interrupt After Last Enable   IALEN. Enable bit for this event.</description>
							<lsb>20</lsb>
							<msb>20</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>IALF</name>
							<description>Interrupt After Last Flag   IALF. Flag bit for this event.</description>
							<lsb>21</lsb>
							<msb>21</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>IALC</name>
							<description>Clear Bit for IALF   IALC. Writing 1 clears the IALF. Writing 0 has no effect. Returns 0 on read.</description>
							<lsb>22</lsb>
							<msb>22</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>IALS</name>
							<description>Set Bit for IALF   IALS. Writing 1 sets the IALF and triggers an interrupt  if enabled . Writing        0 has no effect. Returns 0 on read.</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>write-only</access>
						</field>
						<field>
							<name>T2EN</name>
							<description>TRAIL 2 Injection Enable   T2EN. This bit has to be configured before the transmission of the frame        starts. If set  a new value for the last trailing delay will be injected for the        last data block  as defined with the bit field TRAIL2. If not set  the TRAIL value from the latest BACON will be valid also as the last trailing delay.</description>
							<lsb>30</lsb>
							<msb>30</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>MCEN</name>
							<description>Move Counter Enable   MCEN. Enables the Move Counter feature. If enabled  the MCOUNT value is taken        in consideration  otherwise the standard continuous mode is active.</description>
							<lsb>31</lsb>
							<msb>31</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>OCS</name>
					<description>OCDS Control and Status
 resetvalue={Debug Reset:0x0}</description>

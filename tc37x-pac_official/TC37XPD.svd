					<register>
						<name>CH1_CTRL</name>
						<description>MCS0 Channel 7 Control Register
 resetvalue={Application Reset:0x0}</description>
						<addressOffset>160</addressOffset>
						<size>32</size>
						<resetValue>0</resetValue>
						<resetMask>4294967295</resetMask>
						<fields>
							<field>
								<name>EN</name>
								<description>Enable MCS channel. Note  Enabling or disabling of an MCS channel is synchronized to the ending of an instruction  and thus it may take several clock cycles  e.g. active memory transfers or pending WURM transfers have to be finished before disabling the MCS channel. The internal state of a channel can be obtained by reading bit EN. Note  To disable an MCS channel reliably  the EN bit should be cleared  followed by setting the CAT and CWT bits in order to cancel any pending WURM or ARU instructions. Note  The EN bit is write protected during RAM reset phase.</description>
								<lsb>0</lsb>
								<msb>0</msb>
								<access>read-write</access>
							</field>
							<field>
								<name>IRQ</name>
								<description>Interrupt state. This bit is read only  and it mirrors the internal IRQ state.</description>
								<lsb>1</lsb>
								<msb>1</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>ERR</name>
								<description>Error state. This bit is read only  and it mirrors the internal error state.</description>
								<lsb>2</lsb>
								<msb>2</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CY</name>
								<description>Carry bit state. This bit is read only and it mirrors the internal carry flag CY.</description>
								<lsb>4</lsb>
								<msb>4</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>Z</name>
								<description>Zero bit state. This bit is read only and it mirrors the internal zero flag Z.</description>
								<lsb>5</lsb>
								<msb>5</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>V</name>
								<description>Overflow bit state. This bit is read only and it mirrors the internal carry flag V.</description>
								<lsb>6</lsb>
								<msb>6</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>N</name>
								<description>Negative bit state. This bit is read only and it mirrors the internal zero flag N.</description>
								<lsb>7</lsb>
								<msb>7</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CAT</name>
								<description>Cancel ARU transfer state. This bit is read only and it mirrors the internal cancel ARU transfer        status flag CAT.</description>
								<lsb>8</lsb>
								<msb>8</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>CWT</name>
								<description>Cancel WURM instruction state. This bit is read only and it mirrors the internal cancel WURM        instruction status flag CWT.</description>
								<lsb>9</lsb>
								<msb>9</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>SAT</name>
								<description>Successful ARU transfer bit. This bit is read only  and it mirrors the internal state of the ARU        transfer status flag SAT.</description>
								<lsb>10</lsb>
								<msb>10</msb>
								<access>read-only</access>
							</field>
							<field>
								<name>SP_CNT</name>
								<description>Stack pointer counter value. Actual stack depth of channel. The bit field is incremented on behalf of        a CALL or PUSH instruction and decremented on behalf of a RET or POP        instruction. The MCS channel STK ERR IRQ is raised  when an overflow or        underflow is detected on this bit field.</description>
								<lsb>16</lsb>
								<msb>18</msb>
								<access>read-only</access>
							</field>
						</fields>

							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CEOA</name>
							<description>Content Error Observed on Channel A vSS ContentErrorA    CEOA. A content error was observed in the assigned slot on channel A.</description>
							<lsb>4</lsb>
							<msb>4</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>CEOB</name>
							<description>Content Error Observed on Channel B vSS ContentErrorB    CEOB. A content error was observed in the assigned slot on channel B.</description>
							<lsb>5</lsb>
							<msb>5</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SVOA</name>
							<description>Slot Boundary Violation Observed on Channel A vSS BViolationA    SVOA. A slot boundary violation  channel active at the start or at the end of the assigned slot  was observed on channel A.</description>
							<lsb>6</lsb>
							<msb>6</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>SVOB</name>

							<name>T13RSEL</name>
							<description>Timer T13 External Run Selection   T13RSEL. Bit field T13RSEL defines the event of signal T13HR that can set the run bit T13R by HW.</description>
							<lsb>10</lsb>
							<msb>11</msb>
							<access>read-write</access>
						</field>
					</fields>

									<msb>30</msb>
									<access>read-only</access>
								</field>
								<field>
									<name>SPL</name>
									<description>Schedule Phase Lock   SPL. The bit is valid only when external synchronization is enabled         TTOCN.ESCN     8216 1  8217  . In this case it signals that the difference between        cycle time configured by TTGTP.CTP and the cycle time at the rising edge        at the event trigger is less or equal 9 NTU.</description>
									<lsb>31</lsb>
									<msb>31</msb>
									<access>read-only</access>
								</field>
							</fields>

							<resetValue>0</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>CSM</name>
									<description>Cycle Sync Mark   CSM. The Cycle Sync Mark is measured in cycle time. It is updated when the        reference message becomes valid and retains its value until the next        reference message becomes valid. Captured cycle time</description>
									<lsb>0</lsb>
									<msb>15</msb>
									<access>read-only</access>
								</field>

				<register>
					<name>KRST0</name>
					<description>CPUx  Reset Register 0
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>53248</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RST</name>
							<description>Kernel Reset   RST. This reset bit can be used to request a kernel reset. The kernel reset        will be executed if the reset bits of both kernel registers are set. The RST bit will be cleared  re set to   180 0  180   by the BPI FPI after the        kernel reset was executed.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>RSTSTAT</name>
							<description>Kernel Reset Status   RSTSTAT. This bit indicates wether a kernel reset was executed or not. This bit        is set immediately after the execution of a kernel reset. These bits can be cleared by writing   180 1  180  to the CLR bit in the related        KRSTCLR register.</description>
							<lsb>1</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>KRST1</name>
					<description>CPUx  Reset Register 1
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>53252</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>RST</name>
							<description>Kernel Reset   RST. This reset bit can be used to request a kernel reset. The kernel reset        will be executed if the reset bits of both kernel reset registers is set. The RST bit will be cleared  re set to   180 0  180   after the kernel reset was        executed.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>KRSTCLR</name>
					<description>CPUx Reset Clear Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>53256</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>CLR</name>
							<description>Kernel Reset Status Clear   CLR. Read always as 0.</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>write-only</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FLASHCON0</name>
					<description>CPUx Flash Configuration Register 0
 resetvalue={Application Reset:0x3F3F3F3F,CFS Value:0x22212120}</description>
					<addressOffset>4352</addressOffset>
					<size>32</size>
					<resetValue>572596512</resetValue>
					<resetMask>3806454240</resetMask>
					<fields>
						<field>
							<name>TAG1</name>
							<description>Flash Prefetch Buffer 1 Configuration. FPB is assigned to on  xa0 chip  xa0 bus master with master tag id equal to TAG1.</description>
							<lsb>0</lsb>
							<msb>5</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TAG2</name>
							<description>Flash Prefetch Buffer 2 Configuration. FPB is assigned to on  xa0 chip  xa0 bus master with master tag id equal to TAG2.</description>
							<lsb>8</lsb>
							<msb>13</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TAG3</name>
							<description>Flash Prefetch Buffer 3 Configuration. FPB is assigned to on chip bus master with master tag id equal to TAG3.</description>
							<lsb>16</lsb>
							<msb>21</msb>
							<access>read-write</access>
						</field>
						<field>
							<name>TAG4</name>
							<description>Flash Prefetch Buffer 4 Configuration. FPB is assigned to on chip bus master with master tag id equal to TAG4.</description>
							<lsb>24</lsb>
							<msb>29</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FLASHCON1</name>
					<description>CPUx Flash Configuration Register 1
 resetvalue={Application Reset:0x2020000}</description>
					<addressOffset>4356</addressOffset>
					<size>32</size>
					<resetValue>33685504</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>STALL</name>
							<description>Stall Bus Request. This field must not be changed while any bank is busy. The results are        unpredictable. It is strongly recommended to configure this field once        and avoid changing it during operation. Reading a flash bank  erase counter  or status register  in Sleep Mode        must result in a bus error independent of this field  although it        reports   8220 busy  8221  .</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-write</access>
							<enumeratedValues>
								<enumeratedValue>
									<name>Error0</name>
									<description>0 B Error Reading local PFlash bank  erase counter  or status registers  when DMU STATUS.PxBUSY is set  generates a bus error.</description>
									<value>0</value>
								</enumeratedValue>
								<enumeratedValue>
									<name>Stall1</name>
									<description>1 B Stall Reading local PFlash bank  erase counter  or status registers when DMU HF STATUS.PxBUSY is set delays the response by inserting additional wait cycles until PxBUSY is cleared.</description>
									<value>1</value>
								</enumeratedValue>
							</enumeratedValues>
						</field>
						<field>
							<name>MASKUECC</name>
							<description>Mask PFLASH Uncorrectable ECC Bit Error. No value other than 01 B or 10 B shall be programmed in the register bitfields. The system will behave as specified for 10 B if 00 B or 11 B is programmed.</description>
							<lsb>16</lsb>
							<msb>17</msb>
							<access>read-write</access>
						</field>
					</fields>
				</register>
				<register>
					<name>FLASHCON2</name>
					<description>CPUx Flash Configuration Register 2
 resetvalue={Application Reset:0x0AA020A0A}</description>

				<register>
					<name>SF_ECCS</name>
					<description>HSM DF1 ECC Status Register
 resetvalue={Application Reset:0x0}</description>
					<addressOffset>131140</addressOffset>
					<size>32</size>
					<resetValue>0</resetValue>
					<resetMask>4294967295</resetMask>
					<fields>
						<field>
							<name>ERR1</name>
							<description>Read Access Single Bit ECC Error   ERR1. The flag reports a single bit ECC failure during the last NVM read access. Reset by hardware when DMU SF ECCC .CLR is written to 11 .</description>
							<lsb>0</lsb>
							<msb>0</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ERR2</name>
							<description>Read Access Double Bit ECC Error   ERR2. The flag reports a double bit ECC failure during the last NVM read        access. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>1</lsb>
							<msb>1</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ERR3</name>
							<description>Read Access Triple Bit ECC Error   ERR3. The flag reports a triple bit ECC failure during the last NVM read        access. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>2</lsb>
							<msb>2</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ERRM</name>
							<description>Read Access Multi bit ECC Error   ERRM. The flag reports multi bit ECC failure during the last NVM read access. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>3</lsb>
							<msb>3</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ERRANY</name>
							<description>Any Read Access ECC Error   ERRANY. The flag reports any ECC failure during the last NVM read access. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>7</lsb>
							<msb>7</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>BLANKA</name>
							<description>Read Access Blank Analog   BLANKA. The flag reports that all read data cells have sufficient high current  a program of new data without prior erase is possible. Under certain operation history  a valid complement data entry may also appear as blank. Data qualifiers like headers or footers  which are usually used in EEPROM emulation  can be used to distinguish expected valid data from unknown data fields. Only blank failures in Complement Sensing mode are reported in this flag and is intended for use only in this mode. Blank failures in Single Ended mode is also reported when in CFTM. Reset by hardware when DMU SF ECCC .CLR is written to 11 .</description>
							<lsb>9</lsb>
							<msb>9</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AER1</name>
							<description>Accumulated Single Bit ECC Errors   AER1. The status flag accumulates single bit failures during NVM read        operations. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>16</lsb>
							<msb>16</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AER2</name>
							<description>Accumulated Double Bit ECC Errors   AER2. The status flag accumulates double bit failures during NVM read        operations. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>17</lsb>
							<msb>17</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AER3</name>
							<description>Accumulated Triple Bit ECC Errors   AER3. The status flag accumulates triple bit failures during NVM read operations. Reset by hardware when DMU SF ECCC .CLR is written to 11 .</description>
							<lsb>18</lsb>
							<msb>18</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AERM</name>
							<description>Accumulated Multi bit ECC Errors   AERM. The status bit accumulates multi bit failures during NVM read accesses. Reset by hardware when DMU SF ECCC .CLR is written to 11 .</description>
							<lsb>19</lsb>
							<msb>19</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>AERANY</name>
							<description>Accumulated Any Read Access ECC Error   AERANY. The status bit accumulates ECC failures during NVM read accesses. Reset by hardware when DMU SF ECCC .CLR          is written to 11 .</description>
							<lsb>23</lsb>
							<msb>23</msb>
							<access>read-only</access>
						</field>
						<field>
							<name>ABLANKA</name>
							<description>Accumulated Blank Analog   ABLANKA. The flag accumulates analog evaluated blank failures during NVM read accesses. It reports that all read data cells have sufficient high current  a program of new data without prior erase is possible. Under certain operation history  a valid complement data entry may also appear as blank. Data qualifiers like headers or footers  which are usually used in EEPROM emulation  can be used to distinguish expected valid data from unknown data fields. Only blank failures in Complement Sensing mode are reported in this flag and is intended for use only in this mode. Blank failures in Single Ended mode is also reported when in CFTM. Reset by hardware when DMU SF ECCC .CLR is written to 11 .</description>
							<lsb>25</lsb>
							<msb>25</msb>
							<access>read-only</access>
						</field>
					</fields>
				</register>

							<addressOffset>0</addressOffset>
							<size>32</size>
							<resetValue>0</resetValue>
							<resetMask>4294967295</resetMask>
							<fields>
								<field>
									<name>BOUND</name>
									<description>IP Comparator range lower bound   BOUND. As TriCore instructions are sized in multiples of 16 bit the LSB is fixed to 0. For a functional description of the comparator see CROSSREFERENCE . When defining the comparators for the TriCore instruction pointer keep in mind that many memory locations can be accessed under two different addresses  namely as cached or non cached memory range.</description>
									<lsb>1</lsb>
									<msb>31</msb>
									<access>read-write</access>
								</field>
							</fields>
